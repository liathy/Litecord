    in property <[image]> avatar_pool: [];
    in property <[image]> channel_emoji_pool: [];
    in property <[string]> avatar_pool_urls: [];
    in-out property <[ChatMessage]> messages: [
        { author: "Litecord System", show_header: true, timestamp: Tr.now_label, content: Tr.welcome_msg }
    ];

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Status Header Bar (Frameless Custom Titlebar)
        Rectangle {
            height: 32px;
            background: AppTheme.surface-titlebar;

            if root.drag_area_enabled: TouchArea {
                width: parent.width - 150px;
                height: 100%;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.drag_window();
                    }
                }
            }

            HorizontalBox {
                padding-left: 12px;
                padding-right: 146px;
                padding-top: 0px;
                padding-bottom: 0px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;

                        // Back and forward, like a browser
                        HorizontalLayout {
                            spacing: 2px;
                            alignment: start;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 4px;
                                background: nav_back_ta.pressed && root.can_go_back ? AppTheme.interactive-muted : nav_back_ta.has-hover && root.can_go_back ? AppTheme.interactive-hover : transparent;
                                animate background { duration: 100ms; easing: ease-out; }
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("../assets/arrow-left.svg");
                                    colorize: root.can_go_back ? (nav_back_ta.has-hover ? AppTheme.text-strong : AppTheme.text-secondary) : AppTheme.text-subtle;
                                    opacity: root.can_go_back ? 1 : 0.45;
                                    animate opacity { duration: 100ms; }
                                }
                                nav_back_ta := TouchArea {
                                    enabled: root.can_go_back;
                                    mouse-cursor: root.can_go_back ? pointer : default;
                                    clicked => { root.navigate(false); }
                                }
                            }

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 4px;
                                background: nav_forward_ta.pressed && root.can_go_forward ? AppTheme.interactive-muted : nav_forward_ta.has-hover && root.can_go_forward ? AppTheme.interactive-hover : transparent;
                                animate background { duration: 100ms; easing: ease-out; }
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("../assets/arrow-right.svg");
                                    colorize: root.can_go_forward ? (nav_forward_ta.has-hover ? AppTheme.text-strong : AppTheme.text-secondary) : AppTheme.text-subtle;
                                    opacity: root.can_go_forward ? 1 : 0.45;
                                    animate opacity { duration: 100ms; }
                                }
                                nav_forward_ta := TouchArea {
                                    enabled: root.can_go_forward;
                                    mouse-cursor: root.can_go_forward ? pointer : default;
                                    clicked => { root.navigate(true); }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/app_icon.png");
                                width: 16px;
                                height: 16px;
                                colorize: AppTheme.text-strong;
                                image-fit: contain;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "LITECORD";
                                color: AppTheme.text-strong;
                                font-weight: 800;
                                font-size: TypeScale.body;
                            }
                        }

                        // Versioning string aligned right next to LITECORD
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.app_version;
                                color: AppTheme.text-muted;
                                font-weight: 600;
                                font-size: TypeScale.caption;
                            }
                        }

                        // Discretely show active connection/system error when logged in
                        if root.titlebar_error != "" && root.is_logged_in: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "-";
                                    color: AppTheme.danger;
                                    font-weight: 700;
                                    font-size: TypeScale.caption;
                                }
                                Text {
                                    text: root.titlebar_error;
                                    color: AppTheme.danger;
                                    font-weight: 600;
                                    font-size: TypeScale.caption;
                                }
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            // Custom Window Control Buttons (Hardware Monitor HUD, Settings, Minimize, Maximize, Close)
            HorizontalLayout {
                x: parent.width - (root.show_hardware_monitor ? 390px : 176px);
                y: 0px;
                width: root.show_hardware_monitor ? 390px : 176px;
                height: 32px;
                spacing: 0px;

                // Hardware Monitor HUD (CPU / RAM / GPU) - Centered vertically & matching app theme
                if root.show_hardware_monitor: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding-right: 8px;

                        // CPU
                        Text {
                            text: root.hardware_cpu_text;
                            color: root.hardware_cpu_val > 85 ? AppTheme.danger : AppTheme.text-muted;
                            font-size: TypeScale.caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "•";
                            color: AppTheme.surface-control;
                            font-size: TypeScale.micro;
                            vertical-alignment: center;
                        }

                        // RAM
                        Text {
                            text: root.hardware_ram_text;
                            color: root.hardware_ram_val > 500 ? AppTheme.danger : AppTheme.text-muted;
                            font-size: TypeScale.caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "•";
                            color: AppTheme.surface-control;
                            font-size: TypeScale.micro;
                            vertical-alignment: center;
                        }

                        // GPU
                        Text {
                            text: root.hardware_gpu_text;
                            color: root.hardware_gpu_val > 90 ? AppTheme.danger : AppTheme.text-muted;
                            font-size: TypeScale.caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                // Settings (Accessible on login and main window)
                Rectangle {
                    width: 38px;
                    height: 32px;
                    background: sett_title_touch.has-hover ? AppTheme.surface-sidebar : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/settings.svg");
                                width: 14px;
                                height: 14px;
                                colorize: sett_title_touch.has-hover ? AppTheme.text-strong : AppTheme.text-muted;
                                image-fit: contain;
                            }
                        }
                    }

                    sett_title_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open_settings(); }
                    }
                }

                // Minimize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: min-touch.has-hover ? AppTheme.surface-sidebar : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-minimize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: AppTheme.text-primary;
                                image-fit: contain;
                            }
                        }
                    }

                    min-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.minimize_window(); }
                    }
                }

                // Maximize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: max-touch.has-hover ? AppTheme.surface-sidebar : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: root.is_maximized ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: AppTheme.text-primary;
                                image-fit: contain;
                            }
                        }
                    }

                    max-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.maximize_window(); }
                    }
                }

                // Close
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: close-touch.has-hover ? AppTheme.danger : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-close.svg");
                                width: 10px;
                                height: 10px;
                                colorize: close-touch.has-hover ? AppTheme.text-on-accent : AppTheme.text-primary;
                                image-fit: contain;
                            }
                        }
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close_window(); }
                    }
                }
            }
        }

        // Body Content
        if !root.is_logged_in: Rectangle {
            background: AppTheme.surface-input;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                HorizontalLayout {
                    alignment: center;

                    VerticalLayout {
                        spacing: 10px;
                        width: 720px;

                        // Alert / Status Banner on Login Screen
                        if root.login_alert_message != "": Rectangle {
                            min-height: 38px;
                            background: alert_ta.has-hover ? (root.login_alert_is_error ? AppTheme.danger-action-faint : AppTheme.accent-faint) : (root.login_alert_is_error ? AppTheme.danger-action-subtle : AppTheme.accent-subtle);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.login_alert_is_error ? AppTheme.danger-action-border : AppTheme.accent-border-muted;
                            clip: true;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: root.login_alert_is_error ? @image-url("../assets/alert-triangle.svg") : @image-url("../assets/info.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: root.login_alert_is_error ? AppTheme.danger : AppTheme.accent;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.login_alert_message;
                                    color: root.login_alert_is_error ? AppTheme.danger : AppTheme.text-primary;
                                    font-size: TypeScale.small;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    wrap: word-wrap;
                                }

                                if root.login_alert_is_error : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/settings.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: AppTheme.danger;
                                        opacity: alert_ta.has-hover ? 1.0 : 0.75;
                                    }
                                }
                            }

                            alert_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.settings_active_tab = 6;
                                    root.open_settings();
                                }
                            }
                        }


                        Rectangle {
                            height: 400px;
                            background: AppTheme.surface-sidebar;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: AppTheme.border-subtle;

                        HorizontalLayout {
                            padding: 32px;
                            spacing: 32px;

                            // Left Column: Token / Auto-Detect Login
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;

                                    Image {
                                        source: @image-url("../assets/app_icon.png");
                                        width: 26px;
                                        height: 26px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: root.tr_login_title;
                                        color: AppTheme.text-strong;
                                        font-size: TypeScale.heading;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: root.tr_login_desc;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.small;
                                    wrap: word-wrap;
                                }

                                token_input := LineEdit {
                                    placeholder-text: root.tr_login_placeholder;
                                    input-type: password;
                                    accepted => {
                                        if (token_input.text != "") {
                                            root.login(token_input.text);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/rocket.svg");
                                        text: root.tr_login_btn_connect;
                                        primary: true;
                                        clicked => {
                                            if (token_input.text != "") {
                                                root.login(token_input.text);
                                            }
                                        }
                                    }

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/search.svg");
                                        text: root.tr_login_btn_detect;
                                        clicked => {
                                            root.auto_detect_token();
                                        }
                                    }
                                }
                            }

                            // Middle Divider
                            Rectangle {
                                width: 1px;
                                background: AppTheme.border-subtle;
                            }

                            // Right Column: Official QR Code Login
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 10px;

                                // QR Code Card Container
                                HorizontalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 155px;
                                        height: 155px;
                                        background: AppTheme.solid-white;
                                        border-radius: 8px;
                                        clip: true;

                                        if root.has_qr_code: Image {
                                            source: root.qr_code_image;
                                            width: 155px;
                                            height: 155px;
                                            image-fit: contain;
                                        }

                                        if !root.has_qr_code: VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/qr.svg");
                                                    width: 32px;
                                                    height: 32px;
                                                    colorize: AppTheme.accent;
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                Button {
                                                    text: Tr.qr_generate;
                                                    clicked => { root.refresh_qr_code(); }
                                                }
                                            }
                                        }

                                        // User Scanned Overlay Badge
                                        if root.qr_scanned_user != "": Rectangle {
                                            background: AppTheme.surface-media-overlay;
                                            width: 100%;
                                            height: 100%;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                padding: 8px;

                                                Text {
                                                    text: "✓ " + root.qr_scanned_user;
                                                    color: AppTheme.success;
                                                    font-size: TypeScale.body;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: root.tr_qr_confirm;
                                                    color: AppTheme.text-on-accent;
                                                    font-size: TypeScale.caption;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.tr_qr_title;
                                    color: AppTheme.text-strong;
                                    font-size: TypeScale.title;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_qr_desc;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.caption;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                // Botão Re-gerar QR Code
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 30px;
                                        width: 150px;
                                        background: re_qr_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-input;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: re_qr_ta.has-hover ? AppTheme.info : AppTheme.border-subtle;
                                        animate background { duration: 120ms; }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/qr.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: AppTheme.info;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: Tr.qr_regenerate;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.caption;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }

                                        re_qr_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.refresh_qr_code(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

        if root.is_logged_in: HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // 1. Guilds Sidebar (Servidores com Scroll e tamanho fixado)
            Rectangle {
                width: 72px;
                background: AppTheme.surface-guild-rail;

                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 0px;
                    padding-right: 0px;
                    spacing: 0px;

                    // Direct Messages (Home) Button
                    HorizontalLayout {
                        alignment: center;
                        spacing: 0px;

                        VerticalLayout {
                            alignment: center;
                            width: 8px;
                            Rectangle {
                                width: 4px;
                                height: (root.active_guild_id == "@me") ? 36px : (dm_btn_ta.has-hover ? 16px : (root.total_dm_unread_count > 0 ? 8px : 0px));
                                background: AppTheme.text-strong;
                                border-top-right-radius: 4px;
                                border-bottom-right-radius: 4px;
                                animate height { duration: 150ms; easing: ease-out; }
                            }
                        }

                        Rectangle {
                            height: 48px;
                            width: 48px;
                            background: (root.active_guild_id == "@me") ? AppTheme.accent : (dm_btn_ta.has-hover ? AppTheme.accent : AppTheme.surface-chat);
                            border-radius: (root.active_guild_id == "@me" || dm_btn_ta.has-hover) ? 14px : 16px;
                            clip: false;
                            animate border-radius, background { duration: 150ms; easing: ease-out; }

                            Image {
                                source: @image-url("../assets/dm-chat.svg");
                                width: 24px;
                                height: 24px;
                                colorize: (root.active_guild_id == "@me" || dm_btn_ta.has-hover) ? AppTheme.text-on-accent : AppTheme.text-muted;
                                image-fit: contain;
                                animate colorize { duration: 150ms; }
                            }

                            // Unread Badge (pill no canto inferior direito estilo Discord)
                            if root.total_dm_unread_count > 0: Rectangle {
                                x: parent.width - self.width + 3px;
                                y: parent.height - self.height + 3px;
                                width: root.total_dm_unread_count > 99 ? 28px : (root.total_dm_unread_count > 9 ? 24px : 20px);
                                height: 20px;
                                border-radius: 10px;
                                background: #ed4245;
                                border-width: 2px;
                                border-color: AppTheme.surface-sidebar;

                                Text {
                                    x: -1px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.total_dm_unread_count > 99 ? "99+" : "\{root.total_dm_unread_count}";
                                    color: #ffffff;
                                    font-size: TypeScale.caption;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            dm_btn_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.active_guild_id = "@me";
                                    root.select_guild("@me");
                                }
                            }
                        }

                        Rectangle { width: 8px; }
                    }

                    // Separator below Home button
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        Rectangle {
                            width: 32px;
                            height: 2px;
                            border-radius: 1px;
                            background: AppTheme.separator;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;

                        Flickable {
                            // Scrolled by the wheel: dragging is for reordering the servers.
                            interactive: false;
                            VerticalLayout {
                                padding: 0px;
                                spacing: 10px;
                                alignment: start;

                                for guild[idx] in root.guilds: VerticalLayout {
                                    spacing: 0px;
                                    alignment: center;

                                    // Drop indicator line above guild
                                    if root.drop_target_guild_idx == idx && root.dragging_guild_idx >= 0 && root.dragging_guild_idx != idx: HorizontalLayout {
                                        alignment: center;
                                        padding-top: 2px;
                                        padding-bottom: 2px;
                                        Rectangle {
                                            width: 40px;
                                            height: 3px;
                                            border-radius: 2px;
                                            background: #5865F2;
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 0px;

                                        // Left indicator pill (Discord style). Placed by hand in a box of
                                        // fixed size: inside a layout, its animated height made every frame
                                        // of a hover redo the layout of the whole server column.
                                        Rectangle {
                                            width: 8px;
                                            height: 48px;
                                            Rectangle {
                                                x: 0;
                                                y: (parent.height - self.height) / 2;
                                                width: 4px;
                                                height: (guild.id == root.active_guild_id || (guild.is_folder && !guild.is_expanded && guild.contains_active)) ? 36px : (guild_ta.has-hover ? 16px : 0px);
                                                background: AppTheme.text-strong;
                                                border-top-right-radius: 4px;
                                                border-bottom-right-radius: 4px;
                                                animate height { duration: 150ms; easing: ease-out; }
                                            }
                                            // Line joining the servers of an open folder.
                                            if guild.in_folder: Rectangle {
                                                x: 5px;
                                                y: -5px;
                                                width: 3px;
                                                height: 58px;
                                                background: guild.folder_color;
                                            }
                                        }

                                        Rectangle {
                                            height: 48px;
                                            width: 48px;
                                            background: guild.is_folder
                                                ? guild.folder_color.with-alpha(guild.is_expanded ? 0.32 : (guild_ta.has-hover ? 0.28 : 0.18))
                                                : ((guild.id == root.active_guild_id) ? AppTheme.accent : (guild_ta.has-hover ? AppTheme.accent : AppTheme.surface-chat));
                                            border-radius: (guild.id == root.active_guild_id || guild_ta.has-hover) ? 14px : 16px;
                                            clip: true;
                                            opacity: (root.dragging_guild_idx == idx) ? 0.4 : 1.0;
                                            animate border-radius, background, opacity { duration: 150ms; easing: ease-out; }

                                            if guild.has_image: Image {
                                                source: guild.icon_image;
                                                width: 48px;
                                                height: 48px;
                                                image-fit: cover;
                                            }

                                            if guild.is_folder && (guild.is_expanded || guild.previews.length == 0): Image {
                                                x: 12px;
                                                y: 12px;
                                                width: 24px;
                                                height: 24px;
                                                source: @image-url("../assets/folder.svg");
                                                colorize: guild.folder_color;
                                                image-fit: contain;
                                            }

                                            if guild.is_folder && !guild.is_expanded: Rectangle {
                                                for preview[preview_idx] in guild.previews: Image {
                                                    x: (5 + 20 * Math.mod(preview_idx, 2)) * 1px;
                                                    y: (5 + 20 * Math.floor(preview_idx / 2)) * 1px;
                                                    width: 18px;
                                                    height: 18px;
                                                    source: preview;
                                                    image-fit: cover;
                                                }
                                            }

                                            if !guild.has_image && !guild.is_folder: Text {
                                                text: guild.icon;
                                                color: AppTheme.text-on-accent;
                                                font-size: TypeScale.title;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            guild_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                                        if (root.dragging_guild_idx >= 0 && root.drop_target_guild_idx >= 0 && root.dragging_guild_idx != root.drop_target_guild_idx) {
                                                            root.reorder_guild(root.dragging_guild_idx, root.drop_target_guild_idx);
                                                        }
                                                        root.dragging_guild_idx = -1;
                                                        root.drop_target_guild_idx = -1;
                                                    }
                                                }
                                                // The pressed icon keeps the pointer while it is dragged (no other icon
                                                // sees it), so the target comes from how far it moved: 48px icons, 10px apart.
                                                moved => {
                                                    if (self.pressed && root.guild_drag_enabled) {
                                                        let diff_y = self.mouse-y - self.pressed-y;
                                                        if (root.dragging_guild_idx < 0 && (diff_y > 10px || diff_y < -10px)) {
                                                            root.dragging_guild_idx = idx;
                                                        }
                                                        if (root.dragging_guild_idx == idx) {
                                                            root.drop_target_guild_idx = max(0, min(root.guilds.length - 1, idx + round(diff_y / 58px)));
                                                        }
                                                    }
                                                }
                                                clicked => {
                                                    if (root.dragging_guild_idx < 0) {
                                                        if (guild.is_folder) {
                                                            root.toggle_guild_folder(guild.folder_id);
                                                        } else {
                                                            root.active_guild_id = guild.id;
                                                            root.select_guild(guild.id);
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Spacer to balance the 8px on the left
                                        Rectangle { width: 8px; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Channels Sidebar
            ChannelSidebar {
                sidebar_width <=> root.channel_sidebar_width;
                sidebar_width_committed(w) => { root.channel_sidebar_width_committed(w); }
                active_guild_name: root.active_guild_name;
                tr_server_channels: root.tr_server_channels;
                channels: root.channels;
                avatar_pool: root.avatar_pool;
                emoji_pool: root.channel_emoji_pool;
                avatar_pool_urls: root.avatar_pool_urls;
                is_in_voice: root.is_in_voice;
                is_voice_connecting: root.is_voice_connecting;
                is_muted: root.is_muted;
                is_deafened: root.is_deafened;
                tr_voice_connecting: root.tr_voice_connecting;
                tr_voice_connected: root.tr_voice_connected;
                current_voice_channel: root.current_voice_channel;
                tr_leave: root.tr_leave;
                user_tag: root.user_tag;
                user_display_name: root.user_display_name;
                user_handle: root.user_handle;
                user_avatar_initials: root.user_avatar_initials;
                user_avatar_has_image: root.user_avatar_has_image;
                user_avatar_img: root.user_avatar_img;
                active_channel_id <=> root.active_channel_id;
                select_channel(id) => {
                    root.friends_open = false;
                    root.select_channel(id);
                }
                in_dms: root.active_guild_id == "@me";
                friends_active: root.friends_open;
                friends_pending: root.friends_pending_count;
                open_friends => { root.friends_action("open", ""); }
                toggle_voice_stats => { root.voice_stats_toggle(); }
                voice_quality: root.voice_stats_quality;
                close_dm(id) => { root.close_dm(id); }
                toggle_category(id) => { root.toggle_category(id); }
                reorder_channel(from, to) => { root.reorder_channel(from, to); }
                channel_drop_row(from, dy) => { return root.channel_drop_row(from, dy); }
                leave_voice => { root.leave_voice(); }
                toggle_mute => { root.toggle_mute(); }
                toggle_deafen => { root.toggle_deafen(); }
                open_settings => { root.open_settings(); }
                toggle_user_menu => { root.show_user_menu = !root.show_user_menu; }
                is_voice_focused: root.is_voice_focused;
                open_voice_room => { root.toggle_voice_focus(); }
                open_voice_chat => { root.open_voice_chat(); }
                soundboard_open: root.show_soundboard_panel;
                toggle_soundboard => { root.toggle_soundboard_panel(); }
                stream_row_hover(id, name, y, active) => {
                    root.stream_row_hover_active = active;
                    if (active) {
                        root.stream_preview_shown = true;
                        root.stream_preview_uid = id;
                        root.stream_preview_name = name;
                        root.stream_preview_y = y;
                        root.stream_row_hovered(id);
                    }
                }
                open_user_menu(id, x, y) => { root.open_user_menu(id, x, y); }
                channel_action(name, id, x, y) => { root.channel_action(name, id, x, y); }
                can_manage_channels: root.can_manage_channels;
                can_create_invite: root.can_create_invite;
                in_server: root.active_guild_id != "@me" && root.active_guild_id != "";
                is_screen_sharing: root.is_screen_sharing;
                open_stream_modal => {
                    root.stream_source_tab = "screens";
                    root.open_stream_modal();
                }
                open_camera_modal => {
                    root.stream_source_tab = "cameras";
                    root.open_stream_modal();
                }
                toggle_screen_share => {
                    root.toggle_screen_share();
                }
            }

            // 3. Main Content View (Text Chat OR Voice Room View)
            Rectangle {
                background: AppTheme.surface-sidebar;
                horizontal-stretch: 1;

                if root.friends_open && root.active_guild_id == "@me" && !root.is_voice_focused: FriendsPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    z: 40;
                    rows: root.friends_rows;
                    avatar_pool: root.avatar_pool;
                    avatar_pool_urls: root.avatar_pool_urls;
                    tab: root.friends_tab;
                    pending_count: root.friends_pending_count;
                    empty: root.friends_empty;
                    status: root.friends_status;
                    query <=> root.friends_query;
                    add_name <=> root.friends_add_name;
                    action(name, id) => { root.friends_action(name, id); }
                }

                if root.is_voice_focused && root.is_in_voice: call_area := TouchArea {
                    x: 0px;
                    width: root.call_chat_open ? parent.width - root.call_chat_width : parent.width;
                    height: 100%;
                    init => { root.call_chrome_visible = true; }
                    changed mouse-x => { root.call_chrome_visible = true; call_idle.restart(); }
                    changed mouse-y => { root.call_chrome_visible = true; call_idle.restart(); }
                    changed has-hover => {
                        root.call_chrome_visible = self.has-hover;
                    }

                    call_idle := Timer {
                        interval: 2800ms;
                        running: root.call_chrome_visible && !call_chrome.pointer_inside;
                        triggered => { root.call_chrome_visible = false; }
                    }

                VerticalBox {
                    width: 100%;
                    height: 100%;
                    padding: 0px;
                    spacing: 0px;

                    // Voice Room Connecting Loading State
                    if root.is_voice_connecting: Rectangle {
                        vertical-stretch: 1;
                        background: AppTheme.surface-input;
                        border-top-left-radius: 8px;
                        clip: true;

                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 68px;
                                    height: 68px;
                                    border-radius: 34px;
                                    background: AppTheme.surface-sidebar;
                                    border-width: 2px;
                                    border-color: AppTheme.accent;

                                    Image {
                                        source: @image-url("../assets/speaker.svg");
                                        width: 28px;
                                        height: 28px;
                                        colorize: AppTheme.accent;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: root.tr_voice_connecting_title;
                                    color: AppTheme.text-strong;
                                    font-size: TypeScale.title;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_voice_connecting_desc;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.small;
                                    horizontal-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_cancel;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // Voice Room Participants Dynamic Stage Grid
                    if !root.is_voice_connecting: voice_stage_container := Rectangle {
                        vertical-stretch: 1;
                        background: AppTheme.surface-media;
                        clip: true;

                        VerticalBox {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 56px;
                            padding-bottom: 72px;
                            spacing: 0px;

                            stage_area := Rectangle {
                                for p[tile_index] in root.voice_participants: Rectangle {
                                    property <bool> show_participant: !root.tiles_collapsed
                                        || p.is_streaming
                                        || (p.is_self && root.is_screen_sharing)
                                        || root.focused_stream_uid == p.user_id
                                        || (root.active_stream_user_id != "" && root.active_stream_user_id == p.user_id);
                                    property <bool> is_streaming_attached: (p.is_self && root.is_screen_sharing)
                                        ? (!p.is_stream_hidden && root.popped_out_stream_uid != p.user_id && root.popped_out_stream_uid != "self")
                                        : (root.has_active_stream && (p.is_streaming || root.active_stream_user_id == p.user_id || root.active_stream_user_id == "") && !p.is_stream_hidden && root.popped_out_stream_uid != p.user_id);
                                    property <bool> is_this_stream_focused: (root.focused_stream_uid == p.user_id || (p.is_self && (root.focused_stream_uid == "self" || root.focused_stream_uid == p.user_id)));
                                    // The stream area goes away (hidden, popped out): no GPU video here.
                                    changed is_streaming_attached => {
                                        if (!is_streaming_attached && p.user_id == root.active_stream_user_id) {
                                            root.stream_viewport_changed(0px, 0px, 0px, 0px);
                                        }
                                    }

                                    // Grid of 16:9 tiles, or one focused stream over a row of the others.
                                    property <int> tile_count: root.tiles_collapsed ? root.stream_tile_count : root.voice_participants.length;
                                    property <int> grid_index: root.tiles_collapsed ? p.stream_slot : tile_index;
                                    property <int> columns: tile_count <= 1 ? 1 : (tile_count <= 4 ? 2 : (tile_count <= 9 ? 3 : 4));
                                    property <int> rows: Math.ceil(tile_count / columns);
                                    property <length> gap: 8px;
                                    property <length> cell_w: (stage_area.width - gap * (columns - 1)) / columns;
                                    property <length> cell_h: (stage_area.height - gap * (rows - 1)) / rows;
                                    property <length> grid_w: Math.min(cell_w, cell_h * 16 / 9);
                                    property <length> grid_h: grid_w * 9 / 16;
                                    property <int> grid_column: Math.mod(grid_index, columns);
                                    property <int> grid_row: Math.floor(grid_index / columns);
                                    property <int> row_tiles: grid_row == rows - 1 ? tile_count - (rows - 1) * columns : columns;
                                    property <length> grid_x: (stage_area.width - row_tiles * grid_w - (row_tiles - 1) * gap) / 2 + grid_column * (grid_w + gap);
                                    property <length> grid_y: (stage_area.height - rows * grid_h - (rows - 1) * gap) / 2 + grid_row * (grid_h + gap);
                                    property <bool> stage_focused: root.focused_stream_uid != "";
                                    property <length> strip_h: (root.voice_members_collapsed || tile_count <= 1) ? 0px : 112px;
                                    property <length> focus_h: stage_area.height - (strip_h > 0px ? strip_h + gap : 0px);
                                    property <int> strip_index: tile_index - (tile_index > root.focus_tile_index ? 1 : 0);
                                    property <length> strip_w: 198px;
                                    property <length> strip_total: (tile_count - 1) * strip_w + (tile_count - 2) * gap;
                                    property <length> pointer_x: call_area.mouse-x - (self.absolute-position.x - call_area.absolute-position.x);
                                    property <length> pointer_y: call_area.mouse-y - (self.absolute-position.y - call_area.absolute-position.y);
                                    property <bool> tile_hovered: call_area.has-hover && pointer_x >= 0px && pointer_y >= 0px && pointer_x <= self.width && pointer_y <= self.height;
                                    init => { if (is_this_stream_focused) { root.focus_tile_index = tile_index; } }
                                    changed is_this_stream_focused => { if (is_this_stream_focused) { root.focus_tile_index = tile_index; } }
                                    property <int> tile_position: tile_index;
                                    changed tile_position => { if (is_this_stream_focused) { root.focus_tile_index = tile_position; } }

                                    visible: show_participant && (!stage_focused || is_this_stream_focused || strip_h > 0px);
                                    x: !stage_focused ? grid_x : (is_this_stream_focused ? 0px : (stage_area.width - strip_total) / 2 + strip_index * (strip_w + gap));
                                    y: !stage_focused ? grid_y : (is_this_stream_focused ? 0px : focus_h + gap);
                                    width: !stage_focused ? grid_w : (is_this_stream_focused ? stage_area.width : strip_w);
                                    height: !stage_focused ? grid_h : (is_this_stream_focused ? focus_h : strip_h);
                                    clip: true;
                                    animate x, y, width, height { duration: 180ms; easing: ease-out; }
                                    background: transparent;

                                    // 1. EXPANDED STREAM VIEWPORT (When Streaming in the room & NOT popped out)
                                    if is_streaming_attached: Rectangle {
                                        // The remote stream the GPU may draw under this area.
                                        property <bool> remote_view: !root.is_stream_fullscreen && !(p.is_self && root.is_screen_sharing) && p.user_id == root.active_stream_user_id;
                                        property <length> view_x: self.absolute-position.x;
                                        property <length> view_y: self.absolute-position.y;
                                        init => { if (remote_view) { root.stream_viewport_changed(view_x, view_y, self.width, self.height); } }
                                        changed view_x => { if (remote_view) { root.stream_viewport_changed(view_x, view_y, self.width, self.height); } }
                                        changed view_y => { if (remote_view) { root.stream_viewport_changed(view_x, view_y, self.width, self.height); } }
                                        changed width => { if (remote_view) { root.stream_viewport_changed(view_x, view_y, self.width, self.height); } }
                                        changed height => { if (remote_view) { root.stream_viewport_changed(view_x, view_y, self.width, self.height); } }
                                        changed remote_view => { if (remote_view) { root.stream_viewport_changed(view_x, view_y, self.width, self.height); } }
                                        y: 4px;
                                        height: parent.height - 8px;
                                        background: (root.gpu_video_main && remote_view) ? #010203 : AppTheme.surface-media;
                                        border-radius: 8px;
                                        clip: true;

                                        // Video Canvas (Independent dual buffers: active_stream_frame for self transmitter, remote_stream_frame for remote peer)
                                        if !(root.gpu_video_main && remote_view): Image {
                                            source: (p.is_self && root.is_screen_sharing) ? root.active_stream_frame : root.remote_stream_frame;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: contain;
                                        }

                                        // The border goes over the video: the software renderer clips children
                                        // square, so the picture would cover the border and stick out of the
                                        // rounded corners. The outer ring paints those corners in the colour
                                        // behind the card (its inner edge is the card's rounded outline).
                                        Rectangle {
                                            x: -4px;
                                            y: -4px;
                                            width: parent.width + 8px;
                                            height: parent.height + 8px;
                                            border-radius: 12px;
                                            border-width: 4px;
                                            border-color: AppTheme.surface-media;
                                        }
                                        Rectangle {
                                            border-radius: 8px;
                                            border-width: p.is_speaking ? 3px : ((p.is_self && root.is_screen_sharing) ? 2px : 1px);
                                            border-color: p.is_speaking ? AppTheme.success : ((p.is_self && root.is_screen_sharing) ? AppTheme.accent : AppTheme.border-subtle);
                                        }

                                        // Discord behaviour: clicking the stream focuses it (larger).
                                        // The top bar is declared after this, so its buttons still win.
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.focus_stream(p.user_id); }
                                            pointer-event(event) => {
                                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                    root.open_user_menu(p.user_id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }

                                        // Top Overlay Bar (Left: Live badge, username, mute, prio | Right: Popout, Fullscreen)
                                        stream_top_bar := Rectangle {
                                            visible: root.call_chrome_visible;
                                            x: 8px;
                                            y: 8px;
                                            width: parent.width - 16px;
                                            height: 32px;
                                            background: transparent;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: space-between;

                                                // Left side info container (clipped, expands to take available space)
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    clip: true;
                                                    background: transparent;

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: start;

                                                        // 6. AO VIVO Badge (Priority 6 - least important, hidden first when width < 380px)
                                                        if (stream_top_bar.width >= 380px): Rectangle {
                                                            background: AppTheme.danger;
                                                            border-radius: 4px;
                                                            height: 24px;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 5px;
                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 6px;
                                                                        height: 6px;
                                                                        border-radius: 3px;
                                                                        background: AppTheme.solid-white;
                                                                    }
                                                                }
                                                                Text {
                                                                    text: root.tr_live_badge;
                                                                    color: AppTheme.text-on-accent;
                                                                    font-size: TypeScale.micro;
                                                                    font-weight: 800;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        // 4. Username & Quality Pill (Priority 4 - hidden when width < 210px)
                                                        if (stream_top_bar.width >= 210px): Rectangle {
                                                            background: AppTheme.backdrop;
                                                            border-radius: 4px;
                                                            height: 24px;
                                                            clip: true;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 6px;
                                                                alignment: start;
                                                                Text {
                                                                    text: (stream_top_bar.width >= 320px) ? (p.username + " • " + root.tr_stream_quality) : p.username;
                                                                    color: AppTheme.text-primary;
                                                                    font-size: TypeScale.caption;
                                                                    font-weight: 600;
                                                                    vertical-alignment: center;
                                                                    overflow: elide;
                                                                }
                                                            }
                                                        }

                                                        // 5. FPS Counter Badge (Priority 5 - hidden when width < 310px)
                                                        if (((p.is_self && root.is_screen_sharing && root.local_preview_fps != "") || (!(p.is_self && root.is_screen_sharing) && root.remote_stream_fps != "")) && stream_top_bar.width >= 310px): Rectangle {
                                                        background: AppTheme.success-subtle;
                                                            border-radius: 4px;
                                                            border-width: 1px;
                                                            border-color: AppTheme.success;
                                                            height: 24px;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 5px;
                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 6px;
                                                                        height: 6px;
                                                                        border-radius: 3px;
                                                                        background: AppTheme.success;
                                                                    }
                                                                }
                                                                Text {
                                                                    text: (p.is_self && root.is_screen_sharing) ? root.local_preview_fps : root.remote_stream_fps;
                                                                    color: AppTheme.success;
                                                                    font-size: TypeScale.caption;
                                                                    font-weight: 800;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        // Stream Audio Volume Slider (only shown for remote stream cards when plenty of room >= 560px)
                                                        if !(p.is_self && root.is_screen_sharing) && stream_top_bar.width >= 560px: Rectangle {
                                                            background: AppTheme.backdrop;
                                                            border-radius: 4px;
                                                            height: 24px;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 6px;
                                                                alignment: center;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Image {
                                                                        source: p.stream_volume <= 0.01 ? @image-url("../assets/volume-x.svg") : @image-url("../assets/speaker.svg");
                                                                        width: 12px;
                                                                        height: 12px;
                                                                        colorize: p.stream_volume <= 0.01 ? AppTheme.danger : AppTheme.text-muted;
                                                                        image-fit: contain;
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 55px;
                                                                        height: 5px;
                                                                        background: AppTheme.interactive-hover;
                                                                        border-radius: 2.5px;

                                                                        // Progress fill
                                                                        Rectangle {
                                                                            x: 0;
                                                                            y: 0;
                                                                            width: parent.width * (p.stream_volume.clamp(0.0, 1.0));
                                                                            height: 100%;
                                                                            background: p.stream_volume <= 0.01 ? AppTheme.danger : AppTheme.accent;
                                                                            border-radius: 2.5px;
                                                                        }

                                                                        TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => {
                                                                                let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                                                                root.set_stream_volume(p.user_id, new_vol);
                                                                            }
                                                                            moved => {
                                                                                if self.pressed {
                                                                                    let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                                                                    root.set_stream_volume(p.user_id, new_vol);
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Text {
                                                                        text: "Stream \{Math.round(p.stream_volume * 100)}%";
                                                                        color: AppTheme.text-muted;
                                                                        font-size: TypeScale.micro;
                                                                        font-weight: 700;
                                                                        vertical-alignment: center;
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        // If another user is streaming: Mute button and Priority controls directly on the stream card (when plenty of room >= 700px)
                                                        if !(p.is_self && root.is_screen_sharing) && stream_top_bar.width >= 700px: HorizontalLayout {
                                                            spacing: 4px;
                                                            alignment: start;

                                                            // Stream Mute Button
                                                            Rectangle {
                                                                width: 26px;
                                                                height: 24px;
                                                                border-radius: 4px;
                                                                background: str_mute_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    HorizontalLayout {
                                                                        alignment: center;
                                                                        Image {
                                                                            source: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                                            width: 12px;
                                                                            height: 12px;
                                                                            colorize: p.is_muted ? AppTheme.danger : AppTheme.text-primary;
                                                                            image-fit: contain;
                                                                        }
                                                                    }
                                                                }

                                                                str_mute_ta := TouchArea {
                                                                    mouse-cursor: pointer;
                                                                    clicked => { root.toggle_user_mute(p.user_id); }
                                                                }
                                                            }

                                                            // Stream Speech Priority Control Box
                                                            Rectangle {
                                                                width: 76px;
                                                                height: 24px;
                                                                background: AppTheme.backdrop;
                                                                border-radius: 4px;
                                                                border-width: 1px;
                                                                border-color: p.priority > 0 ? AppTheme.accent : AppTheme.border-subtle;

                                                                HorizontalLayout {
                                                                    padding: 1px;
                                                                    spacing: 2px;

                                                                    Rectangle {
                                                                        width: 18px;
                                                                        height: 20px;
                                                                        border-radius: 3px;
                                                                        background: str_pdec_ta.has-hover ? AppTheme.border-subtle : transparent;
                                                                        Text { text: "-"; color: AppTheme.text-primary; font-size: TypeScale.caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                                        str_pdec_ta := TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => { if p.priority > 0 { root.set_user_priority(p.user_id, p.priority - 1); } }
                                                                        }
                                                                    }

                                                                    VerticalLayout {
                                                                        horizontal-stretch: 1;
                                                                        alignment: center;
                                                                        Text {
                                                                            text: p.priority == 0 ? "Normal" : ("P" + p.priority);
                                                                            color: p.priority > 0 ? AppTheme.accent : AppTheme.text-muted;
                                                                            font-size: TypeScale.micro;
                                                                            font-weight: 700;
                                                                            horizontal-alignment: center;
                                                                        }
                                                                    }

                                                                    Rectangle {
                                                                        width: 18px;
                                                                        height: 20px;
                                                                        border-radius: 3px;
                                                                        background: str_pinc_ta.has-hover ? AppTheme.border-subtle : transparent;
                                                                        Text { text: "+"; color: AppTheme.text-primary; font-size: TypeScale.caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                                        str_pinc_ta := TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => { if p.priority < 3 { root.set_user_priority(p.user_id, p.priority + 1); } }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                // Right side action buttons (Priority: x > desanexar > max)
                                                HorizontalLayout {
                                                    horizontal-stretch: 0;
                                                    spacing: 6px;
                                                    alignment: end;

                                                    // 3. max (Stream Card Focus / Expand Toggle - Priority 3, hidden when width < 160px)
                                                    if (stream_top_bar.width >= 160px): Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_fs_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: is_this_stream_focused ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                                                                    width: 10px;
                                                                    height: 10px;
                                                                    colorize: is_this_stream_focused ? AppTheme.accent : AppTheme.text-on-accent;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_fs_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if is_this_stream_focused {
                                                                    root.focused_stream_uid = "";
                                                                } else {
                                                                    root.focused_stream_uid = (p.is_self && root.is_screen_sharing) ? "self" : p.user_id;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Fullscreen (whole window)
                                                    if (stream_top_bar.width >= 190px): Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_full_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/chrome-maximize.svg");
                                                                    width: 10px;
                                                                    height: 10px;
                                                                    colorize: root.is_stream_fullscreen ? AppTheme.accent : AppTheme.text-on-accent;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_full_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.focused_stream_uid = (p.is_self && root.is_screen_sharing) ? "self" : p.user_id;
                                                                if !root.is_stream_fullscreen {
                                                                    root.toggle_stream_fullscreen();
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // 2. desanexar (Popout Button - Priority 2, hidden when width < 110px)
                                                    if (stream_top_bar.width >= 110px): Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_pop_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/popout.svg");
                                                                    width: 12px;
                                                                    height: 12px;
                                                                    colorize: AppTheme.text-on-accent;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_pop_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.popped_out_stream_uid = p.user_id;
                                                                root.popout_stream_window(p.user_id, p.username);
                                                            }
                                                        }
                                                    }

                                                    // 1. x (Stop Screen Share or Hide Stream - Priority 1, ALWAYS visible)
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_stop_ta.has-hover ? AppTheme.danger : AppTheme.backdrop;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/chrome-close.svg");
                                                                    width: 10px;
                                                                    height: 10px;
                                                                    colorize: AppTheme.text-on-accent;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_stop_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if (p.is_self && root.is_screen_sharing) {
                                                                    root.toggle_screen_share();
                                                                } else {
                                                                    root.hide_stream(p.user_id);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Self-Preview Resource Notice (Single compact line below AO VIVO badge)
                                        if (p.is_self && root.is_screen_sharing && root.show_self_preview_notice): Rectangle {
                                            x: 8px;
                                            y: 38px;
                                            width: parent.width > 230px ? 215px : (parent.width - 16px > 0px ? parent.width - 16px : 0px);
                                            height: 20px;
                                            background: AppTheme.surface-media-overlay-strong;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: AppTheme.accent-border-strong;
                                            clip: true;

                                            HorizontalLayout {
                                                width: 100%;
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 4px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../assets/info.svg");
                                                        width: 11px;
                                                        height: 11px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }

                                                Text {
                                                    text: Tr.preview_reduced;
                                                    color: AppTheme.text-primary;
                                                    font-size: TypeScale.micro;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.show_self_preview_notice = false; }
                                            }
                                        }

                                        // Self-Stream Discord-Style Banner Overlay
                                        if (p.is_self && root.is_screen_sharing): Rectangle {
                                            x: (parent.width - 200px) / 2;
                                            y: parent.height - 34px;
                                            width: 200px;
                                            height: 26px;
                                            background: AppTheme.backdrop-stronger;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: AppTheme.accent;

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../assets/monitor.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: Tr.you_are_streaming;
                                                    color: AppTheme.text-on-accent;
                                                    font-size: TypeScale.caption;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // 2. STANDARD VOICE AUDIO RECTANGLE (When NOT streaming OR when Popped Out)
                                    // The person's tile, with their avatar in the middle.
                                    if !is_streaming_attached: Rectangle {
                                        property <length> avatar_size: Math.min(88px, parent.height * 0.42);
                                        background: AppTheme.surface-elevated;
                                        border-radius: 8px;
                                        border-width: p.is_speaking ? 2px : 0px;
                                        border-color: AppTheme.success;
                                        animate border-width { duration: 90ms; }

                                        TouchArea {
                                            pointer-event(event) => {
                                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                    root.open_user_menu(p.user_id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }

                                        Rectangle {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: avatar_size;
                                            height: avatar_size;
                                            border-radius: avatar_size / 2;
                                            background: AppTheme.interactive-hover;
                                            clip: true;
                                            Text {
                                                text: p.avatar_text;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.title;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            if p.avatar_url != "": Image {
                                                source: p.avatar_img;
                                                width: 100%;
                                                height: 100%;
                                                image-fit: cover;
                                            }
                                        }

                                        Rectangle {
                                            x: 8px;
                                            y: parent.height - self.height - 8px;
                                            width: Math.min(tile_name.preferred-width + 16px, parent.width - 16px);
                                            height: 24px;
                                            border-radius: 6px;
                                            background: AppTheme.backdrop-stronger;
                                            tile_name := Text {
                                                x: 8px;
                                                width: parent.width - 16px;
                                                text: p.username;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.caption;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        // Someone is live and this client is not watching yet.
                                        if p.is_streaming && !p.is_self: Rectangle {
                                            x: parent.width - self.width - 8px;
                                            y: 8px;
                                            width: live_tile_text.preferred-width + 12px;
                                            height: 16px;
                                            border-radius: 8px;
                                            background: AppTheme.danger-action;
                                            live_tile_text := Text {
                                                text: Tr.live_badge;
                                                color: AppTheme.text-on-accent;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        if p.is_streaming && !p.is_self: Rectangle {
                                            x: (parent.width - self.width) / 2;
                                            y: Math.min(parent.height - self.height - 40px, (parent.height + avatar_size) / 2 + 10px);
                                            width: watch_text.preferred-width + 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: watch_ta.pressed ? AppTheme.accent-hover : (watch_ta.has-hover ? AppTheme.accent-bright : AppTheme.accent);
                                            animate background { duration: 120ms; easing: ease-out; }
                                            accessible-role: button;
                                            accessible-label: Tr.watch_stream;
                                            watch_text := Text {
                                                text: Tr.watch_stream;
                                                color: AppTheme.text-on-accent;
                                                font-size: TypeScale.small;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            watch_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.unhide_stream(p.user_id);
                                                    root.focus_stream(p.user_id);
                                                }
                                            }
                                        }

                                        if p.is_muted: Rectangle {
                                            x: parent.width - self.width - 8px;
                                            y: parent.height - self.height - 8px;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 12px;
                                            background: AppTheme.backdrop-stronger;
                                            Image {
                                                width: 14px;
                                                height: 14px;
                                                source: @image-url("../assets/microphone-mute.svg");
                                                colorize: AppTheme.danger;
                                                image-fit: contain;
                                            }
                                        }
                                    }

                                    // Volume and priority of this person, on hover.
                                    if !is_streaming_attached && !p.is_self && tile_hovered && parent.width >= 620px: Rectangle {
                                        x: 4px;
                                        y: parent.height - 72px;
                                        width: parent.width - 8px;
                                        height: 68px;
                                        background: p.is_self ? AppTheme.surface-reply : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: p.is_speaking ? 2px : (p.is_self ? 1px : 0px);
                                        border-color: p.is_speaking ? AppTheme.success : (p.is_self ? AppTheme.accent : transparent);

                                        HorizontalBox {
                                             padding-left: 12px;
                                             padding-right: 12px;
                                             spacing: 12px;

                                             // Avatar Badge with Glowing Green Ring when speaking / Blue accent for self!
                                             VerticalLayout {
                                                 alignment: center;
                                                 Rectangle {
                                                     width: 42px;
                                                     height: 42px;
                                                     border-radius: 21px;
                                                     background: p.is_speaking ? AppTheme.success : (p.is_self ? AppTheme.accent : AppTheme.border-subtle);
                                                     border-width: p.is_speaking ? 3px : (p.is_self ? 2px : 0px);
                                                     border-color: p.is_speaking ? AppTheme.success : (p.is_self ? AppTheme.accent-medium : transparent);
                                                     clip: true;

                                                     Text {
                                                         text: p.avatar_text;
                                                         color: AppTheme.text-on-accent;
                                                         font-size: TypeScale.title;
                                                         font-weight: 700;
                                                         horizontal-alignment: center;
                                                         vertical-alignment: center;
                                                     }
                                                     if p.avatar_url != "": Image {
                                                         source: p.avatar_img;
                                                         width: 100%;
                                                         height: 100%;
                                                         image-fit: cover;
                                                     }
                                                 }
                                             }

                                             // Username & Controls in a Vertical Stack!
                                             VerticalBox {
                                                 horizontal-stretch: 1;
                                                 alignment: center;
                                                 spacing: 6px;
                                                 padding: 0px;

                                                 // Row 1: Username & Badges
                                                 HorizontalLayout {
                                                     spacing: 8px;
                                                     Text {
                                                         text: p.username;
                                                         color: p.is_self ? AppTheme.accent-medium : (p.is_speaking ? AppTheme.text-on-accent : AppTheme.text-primary);
                                                         font-weight: 700;
                                                         font-size: TypeScale.title;
                                                         vertical-alignment: center;
                                                     }

                                                     if p.is_self: Rectangle {
                                                         background: AppTheme.accent;
                                                         border-radius: 4px;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             Text {
                                                                 text: root.tr_badge_you;
                                                                 color: AppTheme.text-on-accent;
                                                                 font-size: TypeScale.micro;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     if (root.popped_out_stream_uid == p.user_id || (p.is_self && root.popped_out_stream_uid == "self")): Rectangle {
                                                         background: AppTheme.accent-subtle;
                                                         border-radius: 4px;
                                                         border-width: 1px;
                                                         border-color: AppTheme.accent;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             Text {
                                                                 text: Tr.detached_badge;
                                                                 color: AppTheme.accent;
                                                                 font-size: TypeScale.micro;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     // Discord-style LIVE badge: solid red, next to the name,
                                                     // and the way to open the stream when it is hidden.
                                                     if (p.is_streaming || (p.is_self && root.is_screen_sharing)): Rectangle {
                                                         horizontal-stretch: 0;
                                                         background: live_badge_ta.has-hover ? AppTheme.danger-action-hover : AppTheme.danger-action;
                                                         border-radius: 4px;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             spacing: 4px;
                                                             VerticalLayout {
                                                                 alignment: center;
                                                                 Rectangle {
                                                                     width: 5px;
                                                                     height: 5px;
                                                                     border-radius: 3px;
                                                                     background: AppTheme.solid-white;
                                                                 }
                                                             }
                                                             Text {
                                                                 text: Tr.live_badge;
                                                                 color: AppTheme.text-on-accent;
                                                                 font-size: TypeScale.micro;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }

                                                         live_badge_ta := TouchArea {
                                                             mouse-cursor: pointer;
                                                             clicked => { root.unhide_stream(p.user_id); }
                                                         }
                                                     }

                                                     if p.is_muted: HorizontalLayout {
                                                         spacing: 4px;
                                                         alignment: start;
                                                         VerticalLayout {
                                                             alignment: center;
                                                             Image {
                                                                 source: @image-url("../assets/volume-x.svg");
                                                                 width: 12px;
                                                                 height: 12px;
                                                                 colorize: AppTheme.danger;
                                                                 image-fit: contain;
                                                             }
                                                         }
                                                         VerticalLayout {
                                                             alignment: center;
                                                             Text {
                                                                 text: Tr.label_muted_caps;
                                                                 color: AppTheme.danger;
                                                                 font-size: TypeScale.caption;
                                                                 font-weight: 700;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     Rectangle { horizontal-stretch: 1; }

                                                      // Intangible Deactivation Button (Active when popout is clicked-through)
                                                      if (root.is_popout_intangible && (root.popped_out_stream_uid == p.user_id || (p.is_self && root.popped_out_stream_uid == "self"))): Rectangle {
                                                          height: 22px;
                                                          border-radius: 4px;
                                                          background: ghost_deact_ta.has-hover ? AppTheme.success-action-hover : AppTheme.success;

                                                          HorizontalLayout {
                                                              padding-left: 8px;
                                                              padding-right: 8px;
                                                              spacing: 5px;

                                                              VerticalLayout {
                                                                  alignment: center;
                                                                  Image {
                                                                      source: @image-url("../assets/ghost.svg");
                                                                      width: 12px;
                                                                      height: 12px;
                                                                      colorize: AppTheme.text-on-accent;
                                                                      image-fit: contain;
                                                                  }
                                                              }

                                                              Text {
                                                                  text: Tr.disable_intangible;
                                                                  color: AppTheme.text-on-accent;
                                                                  font-size: TypeScale.micro;
                                                                  font-weight: 700;
                                                                  vertical-alignment: center;
                                                              }
                                                          }

                                                          ghost_deact_ta := TouchArea {
                                                              mouse-cursor: pointer;
                                                              clicked => {
                                                                  root.toggle_popout_intangible();
                                                              }
                                                          }
                                                      }

                                                 }

                                                 // Row 2: Controls vs Self Info
                                                 if p.is_self: HorizontalLayout {
                                                     spacing: 12px;

                                                     // Animated Mic Volume Meter Bar for Self
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: AppTheme.surface-input;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? AppTheme.success : AppTheme.accent;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Status description for Self
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: root.is_muted ? Tr.label_muted : (p.is_speaking ? Tr.label_transmitting : Tr.label_mic_active);
                                                             color: root.is_muted ? AppTheme.danger : (p.is_speaking ? AppTheme.success : AppTheme.text-subtle);
                                                             font-size: TypeScale.caption;
                                                             font-weight: 600;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                 }

                                                 if !p.is_self: HorizontalLayout {
                                                     spacing: 12px;

                                                     // Animated Volume Level Meter Bar
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: AppTheme.surface-input;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? AppTheme.success : AppTheme.accent;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Mute Button
                                                     VerticalLayout {
                                                         alignment: center;
                                                         IconButton {
                                                             icon: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                             icon-color: p.is_muted ? AppTheme.danger : AppTheme.text-primary;
                                                             clicked => { root.toggle_user_mute(p.user_id); }
                                                         }
                                                     }

                                                     // Volume Text
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: "Vol: " + Math.round(p.volume * 100) + "%";
                                                             color: AppTheme.text-secondary;
                                                             font-size: TypeScale.caption;
                                                             vertical-alignment: center;
                                                         }
                                                     }

                                                      // Slider (0% to 200% with amplification boost like Discord)
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Slider {
                                                              width: 110px;
                                                              minimum: 0.0;
                                                              maximum: 2.0;
                                                              value: p.volume;
                                                              changed(val) => { root.set_user_volume(p.user_id, val); }
                                                          }
                                                      }

                                                      // Speech Priority Control Box (Prioridade de Fala)
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Rectangle {
                                                              width: 86px;
                                                              height: 24px;
                                                              background: AppTheme.surface-sidebar;
                                                              border-radius: 6px;
                                                              border-width: 1px;
                                                              border-color: p.priority > 0 ? AppTheme.accent : AppTheme.border-subtle;

                                                              HorizontalLayout {
                                                                  padding: 2px;
                                                                  spacing: 2px;

                                                                  // "-" Decrement Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: prio_dec_ta.has-hover ? AppTheme.border-subtle : transparent;

                                                                      Text {
                                                                          text: "-";
                                                                          color: AppTheme.text-primary;
                                                                          font-size: TypeScale.small;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      prio_dec_ta := TouchArea {
                                                                          mouse-cursor: pointer;
                                                                          clicked => {
                                                                              if p.priority > 0 {
                                                                                  root.set_user_priority(p.user_id, p.priority - 1);
                                                                              }
                                                                          }
                                                                      }
                                                                  }

                                                                  // Priority Display
                                                                  VerticalLayout {
                                                                      horizontal-stretch: 1;
                                                                      alignment: center;
                                                                      Text {
                                                                          text: p.priority == 0 ? "Normal" : ("Prio " + p.priority);
                                                                          color: p.priority > 0 ? AppTheme.accent : AppTheme.text-muted;
                                                                          font-size: TypeScale.micro;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }
                                                                  }

                                                                  // "+" Increment Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: prio_inc_ta.has-hover ? AppTheme.border-subtle : transparent;

                                                                      Text {
                                                                          text: "+";
                                                                          color: AppTheme.text-primary;
                                                                          font-size: TypeScale.small;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      prio_inc_ta := TouchArea {
                                                                          mouse-cursor: pointer;
                                                                          clicked => {
                                                                              if p.priority < 3 {
                                                                                  root.set_user_priority(p.user_id, p.priority + 1);
                                                                              }
                                                                          }
                                                                      }
                                                                  }
                                                              }
                                                          }
                                                      }
                                                 }
                                             }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                    call_chrome := CallChrome {
                        width: 100%;
                        height: 100%;
                        shown: root.call_chrome_visible || root.is_voice_connecting;
                        title: root.current_voice_channel;
                        stream_user: root.active_stream_user;
                        muted: root.is_muted;
                        deafened: root.is_deafened;
                        sharing: root.is_screen_sharing;
                        has_stream: root.has_active_stream || root.is_screen_sharing;
                        members_collapsed: root.voice_members_collapsed;
                        strip_visible: root.focused_stream_uid != "" && !root.voice_members_collapsed && root.voice_participants.length > 1;
                        web_share_active: root.web_share_active;
                        web_share_pending: root.web_share_pending;
                        share_label: root.is_screen_sharing ? root.tr_stop_screen_share : root.tr_start_screen_share;
                        camera_label: Tr.camera;
                        chat_label: root.tr_view_text_chat;
                        leave_label: root.tr_leave_call;
                        web_label: root.web_share_pending ? Tr.web_share_connecting : (root.web_share_active ? Tr.web_share_title : Tr.web_share_start);
                        toggle_mic => { root.toggle_mute(); }
                        toggle_headset => { root.toggle_deafen(); }
                        open_camera => {
                            root.stream_source_tab = "cameras";
                            root.open_stream_modal();
                        }
                        toggle_share => {
                            if root.is_screen_sharing {
                                root.toggle_screen_share();
                            } else {
                                root.open_stream_modal();
                            }
                        }
                        web_share => {
                            if root.web_share_active {
                                root.web_share_copied = false;
                                root.show_web_share_modal = true;
                            } else {
                                root.toggle_web_share();
                            }
                        }
                        watching_focused_stream: root.has_active_stream && root.active_stream_user_id != "" && root.focused_stream_uid == root.active_stream_user_id;
                        stop_watching => {
                            let watched = root.active_stream_user_id;
                            root.focused_stream_uid = "";
                            root.hide_stream(watched);
                        }
                        leave => { root.leave_voice(); }
                        open_chat => {
                            if root.call_chat_docked {
                                root.call_chat_docked = false;
                            } else {
                                root.call_chat_docked = true;
                                root.dock_voice_chat();
                            }
                        }
                        pop_out => {
                            root.popout_stream_window(root.is_screen_sharing && root.active_stream_user_id == "" ? "self" : root.active_stream_user_id, root.active_stream_user);
                        }
                        fullscreen => { root.toggle_stream_fullscreen(); }
                        toggle_members => { root.voice_members_collapsed = !root.voice_members_collapsed; }
                    }
                }

                if (!root.is_voice_focused || !root.is_in_voice || root.call_chat_open): VerticalBox {
                    x: root.call_chat_open ? parent.width - root.call_chat_width : 0px;
                    width: root.call_chat_open ? root.call_chat_width : parent.width;
                    height: parent.height;
                    padding: 0px;
                    spacing: 0px;

                    // Channel Header
                    Rectangle {
                        height: 44px;
                        background: AppTheme.surface-sidebar;

                        // Left vertical divider line separating channel sidebar from text header bar
                        Rectangle {
                            x: 0px;
                            y: 8px;
                            width: 1px;
                            height: parent.height - 16px;
                            background: AppTheme.separator;
                        }

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;

                            // Show "@" prefix for DMs, "#" for regular channels
                            Text {
                                text: (root.active_guild_id == "@me") ? "@" : "#";
                                color: AppTheme.text-subtle;
                                font-size: TypeScale.heading;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.active_channel_name;
                                color: AppTheme.text-strong;
                                font-size: TypeScale.title;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.call_chat_open: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("../assets/x.svg");
                                    icon-color: AppTheme.text-secondary;
                                    clicked => { root.call_chat_docked = false; }
                                }
                            }

                            if root.active_guild_id != "@me" && root.active_channel_id != "" && !root.call_chat_open: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("../assets/threads.svg");
                                    icon-color: root.channel_panel == "threads" ? AppTheme.text-strong : AppTheme.text-muted;
                                    clicked => { root.channel_panel_action("open", "threads", ""); }
                                }
                            }
                            if root.active_guild_id != "@me" && root.active_channel_id != "" && !root.call_chat_open: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("../assets/bell.svg");
                                    icon-color: root.channel_panel == "notifications" ? AppTheme.text-strong : AppTheme.text-muted;
                                    clicked => { root.channel_panel_action("open", "notifications", ""); }
                                }
                            }
                            if root.active_channel_id != "" && !root.call_chat_open: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("../assets/pin.svg");
                                    icon-color: root.channel_panel == "pins" ? AppTheme.text-strong : AppTheme.text-muted;
                                    clicked => { root.channel_panel_action("open", "pins", ""); }
                                }
                            }

                            // Member list button — servers only
                            if root.active_guild_id != "@me" && !root.call_chat_open: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("../assets/users.svg");
                                    icon-color: root.show_member_list ? AppTheme.text-strong : AppTheme.text-muted;
                                    clicked => { root.toggle_member_list(); }
                                }
                            }

                            if root.active_channel_id != "" && !root.call_chat_open: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("../assets/search.svg");
                                    icon-color: root.channel_panel == "search" ? AppTheme.text-strong : AppTheme.text-muted;
                                    clicked => { root.channel_panel_action("open", "search", ""); }
                                }
                            }

                            // DM Voice Call Button — visible only in Direct Messages
                            if root.active_guild_id == "@me": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 32px;
                                    width: 32px;
                                    border-radius: 6px;
                                    background: root.is_in_dm_call
                                        ? (dm_call_btn_ta.pressed ? #c0392b : (dm_call_btn_ta.has-hover ? #e74c3c : #ed4245))
                                        : (dm_call_btn_ta.pressed ? AppTheme.accent-hover : (dm_call_btn_ta.has-hover ? AppTheme.accent : AppTheme.interactive-muted));
                                    animate background { duration: 120ms; }

                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            Image {
                                                source: root.is_in_dm_call
                                                    ? @image-url("../assets/phone-slash.svg")
                                                    : @image-url("../assets/phone.svg");
                                                width: 16px;
                                                height: 16px;
                                                colorize: AppTheme.text-on-accent;
                                                image-fit: contain;
                                            }
                                        }
                                    }

                                    dm_call_btn_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if root.is_in_dm_call {
                                                root.hangup_dm();
                                            } else {
                                                root.call_dm();
                                            }
                                        }
                                    }
                                }
                            }

                            if root.is_in_voice && !root.call_chat_open: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_vroom_ta.pressed ? AppTheme.accent-hover : (btn_vroom_ta.has-hover ? AppTheme.accent : AppTheme.interactive-muted);
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 12px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/speaker.svg");
                                                width: 15px;
                                                height: 15px;
                                                colorize: AppTheme.text-on-accent;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.tr_view_voice_room;
                                                color: AppTheme.text-on-accent;
                                                font-size: TypeScale.body;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    btn_vroom_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle_voice_focus(); }
                                    }
                                }
                            }
                        }
                    }

                    // Messages Chat Feed & Input Container with rounded top-left corner
                    Rectangle {
                        vertical-stretch: 1;
                        background: AppTheme.surface-chat;
                        border-top-left-radius: 8px;
                        clip: true;

                        if root.member_panel_width > 0px: MemberListPanel {
                            x: parent.width - root.member_panel_width;
                            y: 0px;
                            width: root.member_panel_width;
                            height: parent.height;
                            rows: root.member_rows;
                            avatar_pool: root.avatar_pool;
                            avatar_pool_urls: root.avatar_pool_urls;
                            open_profile(id) => { root.open_profile(id); }
                            open_user_menu(id, x, y) => { root.open_user_menu(id, x, y); }
                            scrolled(first) => { root.members_scrolled(first); }
                        }

                        VerticalBox {
                            x: 0px;
                            y: 0px;
                            width: parent.width - root.member_panel_width;
                            height: parent.height;
                            padding: 0px;
                            spacing: 0px;

                            // Messages Chat Feed View
                            chat_view := ChatMessagesView {
                        vertical-stretch: 1;
                        messages: root.messages;
                        has_more_older_messages: root.has_more_older_messages;
                        is_loading_older_messages: root.is_loading_older_messages;
                        tr_replying_to: root.tr_replying_to;
                        scroll_trigger: root.scroll_to_bottom_trigger;
                        load_older_messages => { root.load_older_messages(); }
                        open_link(url) => { root.open_link(url); }
                        open_profile(id) => { root.open_profile(id); }
                        quick_reactions: root.quick_reactions;
                        highlight_id: root.chat_highlight_id;
                        jumped: root.chat_jumped;
                        jump_fraction: root.chat_jump_fraction;
                        jump_trigger: root.chat_jump_trigger;
                        jump_present => { root.channel_panel_action("present", "", ""); }
                        message_action(name, id, extra, x, y) => { root.message_action(name, id, extra, x, y); }
                        open_user_menu(id, x, y) => { root.open_user_menu(id, x, y); }
                        download_attachment(id, fn, url) => { root.download_attachment(id, fn, url); }
                        open_image(att) => {
                            root.viewer_img = att.full_img;
                            root.viewer_id = att.id;
                            root.viewer_url = att.url;
                            root.viewer_proxy = att.proxy_url;
                            root.viewer_name = att.filename;
                            root.viewer_gif = att.is_gif;
                            root.viewer_width = att.width;
                            root.viewer_height = att.height;
                            root.viewer_open = true;
                            root.image_viewer("open");
                        }
                        click_command(cmd) => {
                            root.click_command(cmd);
                        }
                        bottom_state_changed(flag) => {
                            root.chat_is_at_bottom = flag;
                        }
                    }

                    // Smart Slash Command Autocomplete / Suggestions Box (Discord Style)
                    if root.show_command_suggestions : Rectangle {
                        height: Math.min(220px, (root.command_suggestions.length * 44 + 36) * 1px);
                        background: AppTheme.surface-sidebar;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border-subtle;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: AppTheme.surface-scrim;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/terminal.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: AppTheme.accent;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: Tr.smart_commands;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.micro;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: Tr.click_autocomplete;
                                    color: AppTheme.accent;
                                    font-size: TypeScale.micro;
                                    vertical-alignment: center;
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 3px;
                                    for cmd[idx] in root.command_suggestions: Rectangle {
                                        height: 38px;
                                        background: (idx == root.active_suggestion_index || cmd_sug_ta.has-hover) ? AppTheme.interactive-hover : AppTheme.surface-input;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: (idx == root.active_suggestion_index) ? AppTheme.accent : (cmd_sug_ta.has-hover ? AppTheme.accent-border-muted : transparent);

                                         HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/terminal.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: (idx == root.active_suggestion_index) ? AppTheme.accent-link-hover : AppTheme.text-subtle;
                                                    image-fit: contain;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.name;
                                                    color: (idx == root.active_suggestion_index) ? AppTheme.text-strong : AppTheme.accent-link-hover;
                                                    font-size: TypeScale.body;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Bot Identifier Badge (e.g. [ Jockie Music ] or [ FredBoat ])
                                            if cmd.app_name != "" : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 18px;
                                                    background: (idx == root.active_suggestion_index) ? AppTheme.accent-selected : AppTheme.accent-subtle;
                                                    border-radius: 3px;
                                                    border-width: 1px;
                                                    border-color: (idx == root.active_suggestion_index) ? AppTheme.accent-border-strong : AppTheme.accent-selected;
                                                    HorizontalLayout {
                                                        padding-left: 5px;
                                                        padding-right: 5px;
                                                        alignment: center;
                                                        Text {
                                                            text: cmd.app_name;
                                                            color: (idx == root.active_suggestion_index) ? AppTheme.text-strong : AppTheme.accent-soft;
                                                            font-size: TypeScale.micro;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.desc;
                                                    color: (idx == root.active_suggestion_index) ? AppTheme.text-primary : AppTheme.text-muted;
                                                    font-size: TypeScale.caption;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.usage;
                                                    color: (idx == root.active_suggestion_index) ? AppTheme.text-muted : AppTheme.text-faint;
                                                    font-size: TypeScale.micro;
                                                    font-family: "Courier New";
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        cmd_sug_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.select_suggestion(idx);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Files waiting to be sent with the next message
                    if root.pending_files.length > 0 || root.file_upload_error != "": Rectangle {
                        height: root.pending_files.length > 0 ? (root.file_upload_error != "" || root.file_uploading ? 84px : 64px) : 28px;
                        background: AppTheme.surface-sidebar;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 6px;
                            padding-bottom: 4px;
                            spacing: 3px;

                            if root.pending_files.length > 0: ScrollView {
                                height: 52px;
                                viewport-width: file_row.preferred-width;
                                viewport-height: 50px;

                                file_row := HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for file[index] in root.pending_files: Rectangle {
                                        width: 180px;
                                        height: 48px;
                                        border-radius: 6px;
                                        background: AppTheme.surface-elevated;
                                        border-width: 1px;
                                        border-color: AppTheme.border-subtle;

                                        VerticalLayout {
                                            x: 10px;
                                            width: parent.width - 40px;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: file.name;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.small;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: file.size;
                                                color: AppTheme.text-muted;
                                                font-size: TypeScale.micro;
                                            }
                                        }

                                        if !root.file_uploading: Rectangle {
                                            x: parent.width - 26px;
                                            y: 14px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: remove_file_ta.has-hover ? AppTheme.danger-action : AppTheme.interactive-muted;
                                            Image {
                                                source: @image-url("../assets/x.svg");
                                                width: 10px;
                                                height: 10px;
                                                colorize: AppTheme.text-strong;
                                            }
                                            remove_file_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.remove_pending_file(index); }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.file_uploading || root.file_upload_error != "": Text {
                                text: root.file_uploading ? Tr.uploading_files : root.file_upload_error;
                                color: root.file_uploading ? AppTheme.text-muted : AppTheme.danger;
                                font-size: TypeScale.caption;
                                overflow: elide;
                            }
                        }
                    }

                    if root.reply_to_id != "" || root.editing_message_id != "": Rectangle {
                        height: 32px;
                        background: AppTheme.surface-elevated;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.editing_message_id != "" ? "Editing message" : "Replying to " + root.reply_to_name;
                                color: AppTheme.text-secondary;
                                font-size: TypeScale.small;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: cancel_compose_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                    Image {
                                        width: 10px;
                                        height: 10px;
                                        source: @image-url("../assets/x.svg");
                                        colorize: AppTheme.text-muted;
                                    }
                                    cancel_compose_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.editing_message_id != "") { root.chat_input_text = ""; }
                                            root.editing_message_id = "";
                                            root.reply_to_id = "";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Message / Smart Command Input Box
                    Rectangle {
                        height: 64px;
                        background: AppTheme.surface-chat;

                        // One rounded bar holds everything, like Discord's.
                        Rectangle {
                            x: 8px;
                            y: 4px;
                            width: parent.width - 16px;
                            height: 52px;
                            border-radius: 8px;
                            background: AppTheme.surface-input;
                            border-width: 1px;
                            border-color: AppTheme.border-subtle;
                        }

                        HorizontalLayout {
                            x: 8px;
                            y: 4px;
                            width: parent.width - 16px;
                            height: 52px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;

                            if root.active_command_name != "" : HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;

                                // Command Pill (e.g. /play or /247)
                                Rectangle {
                                    background: AppTheme.accent-subtle;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: AppTheme.accent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/terminal.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: AppTheme.accent-link-hover;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.active_command_name;
                                            color: AppTheme.accent-link-hover;
                                            font-size: TypeScale.body;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/x.svg");
                                                width: 10px;
                                                height: 10px;
                                                colorize: close_cmd_ta.has-hover ? AppTheme.text-strong : AppTheme.text-muted;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                    close_cmd_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active_command_name = "";
                                            root.command_arg_text = "";
                                        }
                                    }
                                }

                                // Parameter Pill (e.g. [query] or [song] or [volume])
                                if root.active_param_name != "" : Rectangle {
                                    background: AppTheme.surface-elevated;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: AppTheme.separator;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/param.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: AppTheme.accent;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.active_param_name + ":";
                                            color: AppTheme.accent;
                                            font-size: TypeScale.small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Value Input
                                msg_arg_input := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.command_arg_text;
                                    font-family: ChatTypography.family;
                                    font-size: ChatTypography.body-size;
                                    placeholder-text: root.active_param_name != "" ? (root.active_param_desc != "" ? root.active_param_desc : Tr.type_value_for + root.active_param_name + "...") : Tr.press_enter_or_send + root.active_command_name + "...";
                                    accepted => {
                                        root.execute_active_command(
                                            root.active_command_name,
                                            root.command_arg_text,
                                            root.active_command_app_id,
                                            root.active_command_cmd_id,
                                            root.active_command_version,
                                            root.active_param_name
                                        );
                                        root.active_command_name = "";
                                        root.command_arg_text = "";
                                    }
                                }
                            }

                            // Attach files
                            VerticalLayout {
                                alignment: center;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 6px;
                                background: attach_btn_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                animate background { duration: 120ms; }

                                Image {
                                    x: 7px;
                                    y: 7px;
                                    width: 20px;
                                    height: 20px;
                                    source: @image-url("../assets/plus.svg");
                                    colorize: attach_btn_ta.has-hover ? AppTheme.text-strong : AppTheme.text-secondary;
                                    image-fit: contain;
                                }

                                attach_btn_ta := TouchArea {
                                    enabled: !root.file_uploading;
                                    mouse-cursor: pointer;
                                    clicked => { root.pick_files(); }
                                }
                            }
                            }

                            if root.active_command_name == "" : Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                                clip: true;

                                if root.chat_input_text == "" : Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text: root.tr_chat_placeholder_prefix + (root.active_guild_id == "@me" ? "@" : "#") + root.active_channel_name;
                                    color: AppTheme.text-subtle;
                                    font-family: ChatTypography.family;
                                    font-size: ChatTypography.body-size;
                                    vertical-alignment: center;
                                }

                                chat_text_input := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text <=> root.chat_input_text;
                                    color: AppTheme.text-primary;
                                    font-family: ChatTypography.family;
                                    font-size: ChatTypography.body-size;
                                    vertical-alignment: center;
                                    single-line: true;
                                    key-pressed(event) => {
                                        if (root.show_mentions && root.mention_items.length > 0) {
                                            if (event.text == Key.UpArrow) {
                                                root.mention_index = root.mention_index > 0 ? root.mention_index - 1 : root.mention_items.length - 1;
                                                return accept;
                                            }
                                            if (event.text == Key.DownArrow) {
                                                root.mention_index = root.mention_index < root.mention_items.length - 1 ? root.mention_index + 1 : 0;
                                                return accept;
                                            }
                                            if (event.text == Key.Tab || event.text == Key.Return) {
                                                root.pick_mention(root.mention_index);
                                                self.set-selection-offsets(2147483647, 2147483647);
                                                return accept;
                                            }
                                            if (event.text == Key.Escape) {
                                                root.show_mentions = false;
                                                return accept;
                                            }
                                        }
                                        if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                            if (event.text == Key.UpArrow) {
                                                root.move_suggestion_up();
                                                return accept;
                                            }
                                            if (event.text == Key.DownArrow) {
                                                root.move_suggestion_down();
                                                return accept;
                                            }
                                            if (event.text == Key.Tab) {
                                                root.select_suggestion(root.active_suggestion_index);
                                                return accept;
                                            }
                                            if (event.text == Key.Escape) {
                                                root.show_command_suggestions = false;
                                                return accept;
                                            }
                                        }
                                        reject
                                    }
                                    edited => {
                                        root.active_suggestion_index = 0;
                                        root.handle_input_change(self.text);
                                    }
                                    accepted => {
                                        if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                            root.select_suggestion(root.active_suggestion_index);
                                        } else if ((root.chat_input_text != "" || root.pending_files.length > 0) && !root.file_uploading) {
                                            root.send_message(root.chat_input_text);
                                            root.chat_input_text = "";
                                            root.show_command_suggestions = false;
                                        }
                                    }
                                }
                            }

                            // GIF picker
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: gif_btn_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                    animate background { duration: 120ms; easing: ease-out; }
                                    Rectangle {
                                        x: 5px;
                                        y: 7px;
                                        width: 22px;
                                        height: 18px;
                                        border-radius: 4px;
                                        background: gif_btn_ta.has-hover || root.show_gif_picker ? AppTheme.text-strong : AppTheme.text-secondary;
                                        Text {
                                            text: "GIF";
                                            color: AppTheme.surface-input;
                                            font-size: 10px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    gif_btn_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.show_gif_picker) {
                                                root.show_gif_picker = false;
                                            } else {
                                                root.open_expression("gif");
                                            }
                                        }
                                    }
                                }
                            }

                            // Sticker picker
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: sticker_btn_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                    animate background { duration: 120ms; easing: ease-out; }
                                    Image {
                                        x: 5px;
                                        y: 5px;
                                        width: 22px;
                                        height: 22px;
                                        source: @image-url("../assets/sticker.svg");
                                        colorize: sticker_btn_ta.has-hover || root.show_sticker_picker ? AppTheme.text-strong : AppTheme.text-secondary;
                                        image-fit: contain;
                                    }
                                    sticker_btn_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.show_sticker_picker) {
                                                root.show_sticker_picker = false;
                                            } else {
                                                root.open_expression("sticker");
                                            }
                                        }
                                    }
                                }
                            }

                            // Emoji picker
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: emoji_btn_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                    animate background { duration: 120ms; easing: ease-out; }
                                    Image {
                                        x: 5px;
                                        y: 5px;
                                        width: 22px;
                                        height: 22px;
                                        source: @image-url("../assets/emoji.svg");
                                        colorize: emoji_btn_ta.has-hover || root.show_emoji_picker ? AppTheme.text-strong : AppTheme.text-secondary;
                                        image-fit: contain;
                                    }
                                    emoji_btn_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.show_emoji_picker) {
                                                root.show_emoji_picker = false;
                                            } else {
                                                root.reaction_target_id = "";
                                                root.open_expression("emoji");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    }

    // Settings overlay: backend state stays on AppWindow.
    if root.show_settings_modal: SettingsView {
        tr_settings_title: root.tr_settings_title;
        app_version: root.app_version;
        settings_active_tab <=> root.settings_active_tab;
        tr_settings_tab_voice: root.tr_settings_tab_voice;
        tr_settings_tab_language: root.tr_settings_tab_language;
        tr_settings_tab_keybinds: root.tr_settings_tab_keybinds;
        tr_settings_tab_video_interface: root.tr_settings_tab_video_interface;
        tr_settings_tab_security: root.tr_settings_tab_security;
        tr_settings_tab_network_proxy: root.tr_settings_tab_network_proxy;
        tr_settings_tab_updates: root.tr_settings_tab_updates;
        tr_settings_output_device: root.tr_settings_output_device;
        output_devices: root.output_devices;
        tr_settings_input_device: root.tr_settings_input_device;
        input_devices: root.input_devices;
        mic_volume <=> root.mic_volume;
        notification_volume <=> root.notification_volume;
        tr_settings_threshold: root.tr_settings_threshold;
        vad_threshold <=> root.vad_threshold;
        tr_settings_mic_level: root.tr_settings_mic_level;
        mic_level: root.mic_level;
        is_testing_mic: root.is_testing_mic;
        tr_settings_btn_test_stop: root.tr_settings_btn_test_stop;
        tr_settings_btn_test_start: root.tr_settings_btn_test_start;
        languages: root.languages;
        tr_keybind_mute_title: root.tr_keybind_mute_title;
        tr_keybind_mute_desc: root.tr_keybind_mute_desc;
        recording_keybind_for: root.recording_keybind_for;
        tr_keybind_recording_prompt: root.tr_keybind_recording_prompt;
        keybind_mute_str: root.keybind_mute_str;
        tr_keybind_btn_record: root.tr_keybind_btn_record;
        tr_keybind_btn_clear: root.tr_keybind_btn_clear;
        tr_keybind_guide_title: root.tr_keybind_guide_title;
        tr_keybind_guide_desc: root.tr_keybind_guide_desc;
        tr_keybind_deafen_title: root.tr_keybind_deafen_title;
        tr_keybind_deafen_desc: root.tr_keybind_deafen_desc;
        keybind_deafen_str: root.keybind_deafen_str;
        noise_suppression_options: root.noise_suppression_options;
        echo_cancellation: root.echo_cancellation;
        automatic_gain_control: root.automatic_gain_control;
        video_encoder_options: root.video_encoder_options;
        gpu_selection_available: root.gpu_selection_available;
        stream_capture_status: root.stream_capture_status;
        use-light-theme: root.use-light-theme;
        theme_mode_name: root.theme_mode_name;
        video_capture_options: root.video_capture_options;
        audio_loopback_options: root.audio_loopback_options;
        enable_self_preview_notice: root.enable_self_preview_notice;
        show_hardware_monitor: root.show_hardware_monitor;
        use_gpu_renderer: root.use_gpu_renderer;
        net_diag_running: root.net_diag_running;
        net_diag_verdict: root.net_diag_verdict;
        net_diag_signaling_ok: root.net_diag_signaling_ok;
        net_diag_copied: root.net_diag_copied;
        proxy_mode_options: root.proxy_mode_options;
        selected_proxy_mode <=> root.selected_proxy_mode;
        proxy_host_input <=> root.proxy_host_input;
        proxy_port_input <=> root.proxy_port_input;
        proxy_username_input <=> root.proxy_username_input;
        proxy_password_input <=> root.proxy_password_input;
        proxy_is_testing: root.proxy_is_testing;
        proxy_route_media_enabled: root.proxy_route_media_enabled;
        proxy_test_status_text: root.proxy_test_status_text;
        proxy_test_is_success: root.proxy_test_is_success;
        update_check_feedback: root.update_check_feedback;
        is_checking_update: root.is_checking_update;
        tr_settings_done: root.tr_settings_done;
        close_settings => { root.close_settings(); }
        select_output_device(arg0) => { root.select_output_device(arg0); }
        select_input_device(arg0) => { root.select_input_device(arg0); }
        set_mic_volume(arg0) => { root.set_mic_volume(arg0); }
        change_notification_volume(arg0) => { root.change_notification_volume(arg0); }
        preview_notification_sound => { root.preview_notification_sound(); }
        set_vad_threshold(arg0) => { root.set_vad_threshold(arg0); }
        toggle_test_mic => { root.toggle_test_mic(); }
        select_noise_suppression(arg0) => { root.select_noise_suppression(arg0); }
        toggle_echo_cancellation => { root.toggle_echo_cancellation(); }
        toggle_automatic_gain_control => { root.toggle_automatic_gain_control(); }
        change_language(arg0) => { root.change_language(arg0); }
        start_recording_keybind(arg0) => { root.start_recording_keybind(arg0); }
        reset_keybind(arg0) => { root.reset_keybind(arg0); }
        select_video_encoder(arg0) => { root.select_video_encoder(arg0); }
        toggle_theme => { root.toggle_theme(); }
        select_theme_mode(mode) => { root.select_theme_mode(mode); }
        select_video_capture_backend(arg0) => { root.select_video_capture_backend(arg0); }
        select_audio_loopback_backend(arg0) => { root.select_audio_loopback_backend(arg0); }
        toggle_enable_self_preview_notice => { root.toggle_enable_self_preview_notice(); }
        toggle_hardware_monitor => { root.toggle_hardware_monitor(); }
        toggle_gpu_renderer => { root.toggle_gpu_renderer(); }
        run_network_diagnostics => { root.run_network_diagnostics(); }
        copy_network_diagnostics => { root.copy_network_diagnostics(); }
        select_proxy_mode(arg0) => { root.select_proxy_mode(arg0); }
        test_proxy_requested(arg0, arg1, arg2, arg3, arg4) => { root.test_proxy_requested(arg0, arg1, arg2, arg3, arg4); }
        save_proxy_settings(arg0, arg1, arg2, arg3, arg4, arg5) => { root.save_proxy_settings(arg0, arg1, arg2, arg3, arg4, arg5); }
        check_for_updates => { root.check_for_updates(); }
    }

    // Multi-Account / Switch Account & Logout Modal
    if root.show_profile: ProfileCard {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        loading: root.profile_loading;
        display_name: root.profile_name;
        username: root.profile_username;
        pronouns: root.profile_pronouns;
        bio: root.profile_bio;
        member_since: root.profile_member_since;
        avatar_text: root.profile_avatar_text;
        avatar: root.profile_avatar;
        has_avatar: root.profile_has_avatar;
        accent: root.profile_accent;
        roles: root.profile_roles;
        mutual: root.profile_mutual;
        has_status: root.profile_has_status;
        badges: root.profile_badges;
        tag: root.profile_tag;
        status_color: root.profile_status_color;
        status: root.profile_status;
        activity: root.profile_activity;
        banner: root.profile_banner;
        has_banner: root.profile_has_banner;
        send_dm(text) => { root.profile_send_dm(text); }
        close => { root.show_profile = false; }
    }

    // A click anywhere outside an open picker closes it.
    if root.show_gif_picker || root.show_emoji_picker || root.show_sticker_picker || root.show_soundboard_panel: TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => {
            root.show_gif_picker = false;
            root.show_emoji_picker = false;
            root.show_sticker_picker = false;
            root.show_soundboard_panel = false;
            root.reaction_target_id = "";
        }
    }

                    // Discord-style Soundboard Panel Box
                    if root.show_soundboard_panel : Rectangle {
                        x: 80px;
                        y: root.height - self.height - 160px;
                        width: 420px;
                        height: 220px;
                        background: AppTheme.surface-elevated;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border-subtle;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: AppTheme.surface-scrim;

                        // Clicks on the panel stay on the panel.
                        TouchArea {}

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Soundboard";
                                        color: AppTheme.text-strong;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: close_sb_ta.has-hover ? AppTheme.interactive-hover : transparent;

                                    Image {
                                        source: @image-url("../assets/x.svg");
                                        width: 10px;
                                        height: 10px;
                                        colorize: AppTheme.text-muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    close_sb_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.show_soundboard_panel = false; }
                                    }
                                }
                            }

                            // Soundboard 2-row Grid
                            VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 6px;

                                for srow in root.soundboard_rows: HorizontalLayout {
                                    spacing: 8px;
                                    for s in srow.sounds: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 64px;
                                        border-radius: 6px;
                                        background: sb_cell_ta.has-hover ? AppTheme.interactive-selected : AppTheme.surface-elevated;
                                        border-width: 1px;
                                        border-color: sb_cell_ta.has-hover ? AppTheme.accent : AppTheme.border-subtle;
                                        animate background { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;

                                            Text {
                                                text: s.icon;
                                                font-size: 20px;
                                                horizontal-alignment: center;
                                            }

                                            Text {
                                                text: s.name;
                                                color: AppTheme.text-strong;
                                                font-size: 11px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        sb_cell_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.play_soundboard_sound(s.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Emoji tab
                    if root.show_emoji_picker : Rectangle {
                        x: root.width - self.width - root.member_panel_width - 16px;
                        y: root.height - self.height - 76px;
                        width: 500px;
                        height: 540px;
                        background: AppTheme.surface-elevated;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border-subtle;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: AppTheme.surface-scrim;
                        TouchArea {}

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            ExpressionTabs {
                                active: "emoji";
                                select(tab) => { root.open_expression(tab); }
                            }

                            LineEdit {
                                placeholder-text: "Find the perfect emoji";
                                edited(query) => { root.emoji_search(query); }
                            }

                            HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: 6px;
                                ListView {
                                    width: 52px;
                                    for item in root.emoji_rail: Rectangle {
                                        height: 46px;
                                        init => {
                                            if (item.emoji_id != "" && !item.has_icon) { root.load_picker_emoji(item.emoji_id); }
                                        }
                                        Rectangle {
                                            x: 4px;
                                            y: 3px;
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 12px;
                                            background: emoji_rail_ta.has-hover || false ? AppTheme.interactive-selected : AppTheme.surface-input;
                                            animate background { duration: 100ms; easing: ease-out; }
                                            clip: true;
                                            if item.is_recent: Image {
                                                x: 9px;
                                                y: 9px;
                                                width: 22px;
                                                height: 22px;
                                                source: @image-url("../assets/clock.svg");
                                                colorize: AppTheme.text-secondary;
                                            }
                                            if !item.is_recent && item.has_icon: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: item.icon;
                                                image-fit: cover;
                                            }
                                            if !item.is_recent && !item.has_icon: Text {
                                                text: item.initial;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.body;
                                                font-weight: 700;
                                            }
                                            emoji_rail_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { emoji_list.viewport-y = -item.row * 42px; }
                                            }
                                        }
                                    }
                                }

                                emoji_list := ListView {
                                    horizontal-stretch: 1;
                                    for row in root.emoji_rows: Rectangle {
                                        height: 42px;

                                        if row.header != "": Text {
                                            x: 4px;
                                            width: parent.width - 8px;
                                            height: parent.height;
                                            text: row.header;
                                            color: AppTheme.text-secondary;
                                            font-size: TypeScale.small;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        if row.header == "": HorizontalLayout {
                                            alignment: start;
                                            spacing: 2px;
                                            for e in row.emojis: Rectangle {
                                                width: 42px;
                                                height: 40px;
                                                border-radius: 6px;
                                                background: emoji_cell_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                                animate background { duration: 90ms; easing: ease-out; }
                                                init => {
                                                    if (e.img.width == 0 && e.emoji_id != "") { root.load_picker_emoji(e.emoji_id); }
                                                }

                                                if e.img.width == 0 && !e.is_custom: Text {
                                                    text: e.code;
                                                    font-size: 20px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                if e.img.width > 0: Image {
                                                    x: 6px;
                                                    y: 5px;
                                                    width: 30px;
                                                    height: 30px;
                                                    source: e.img;
                                                    image-fit: contain;
                                                    opacity: e.locked ? 0.35 : 1;
                                                }

                                                if e.locked: Rectangle {
                                                    x: 24px;
                                                    y: 22px;
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: 8px;
                                                    background: AppTheme.backdrop-max;
                                                    Image {
                                                        width: 10px;
                                                        height: 10px;
                                                        source: @image-url("../assets/lock.svg");
                                                        colorize: AppTheme.solid-white;
                                                    }
                                                }

                                                emoji_cell_ta := TouchArea {
                                                    mouse-cursor: e.locked ? default : pointer;
                                                    changed has-hover => {
                                                        if (self.has-hover) {
                                                            root.emoji_preview_name = ":" + e.name + ":";
                                                            root.emoji_preview_img = e.img;
                                                        }
                                                    }
                                                    clicked => {
                                                        if (!e.locked) { root.select_emoji(e.code); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 40px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: emoji_jump_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                            animate background { duration: 90ms; easing: ease-out; }
                                            Image {
                                                width: 24px;
                                                height: 24px;
                                                source: @image-url("../assets/emoji.svg");
                                                colorize: emoji_jump_ta.has-hover ? AppTheme.text-strong : AppTheme.text-muted;
                                                image-fit: contain;
                                            }
                                            emoji_jump_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (root.emoji_unicode_row >= 0) { emoji_list.viewport-y = -root.emoji_unicode_row * 42px; }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            width: 28px;
                                            height: 28px;
                                            source: root.emoji_preview_img;
                                            image-fit: contain;
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.emoji_preview_name;
                                        color: AppTheme.text-strong;
                                        font-size: TypeScale.body;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // GIF picker
                    if root.show_gif_picker : Rectangle {
                        x: root.width - self.width - root.member_panel_width - 16px;
                        y: root.height - self.height - 76px;
                        width: 480px;
                        height: 520px;
                        background: AppTheme.surface-elevated;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border-subtle;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: AppTheme.surface-scrim;

                        // Clicks on the popup stay on the popup.
                        TouchArea {}

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            ExpressionTabs {
                                active: "gif";
                                select(tab) => { root.open_expression(tab); }
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: Tr.gif_search;
                                    accepted(query) => { root.search_gifs(query); }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: close_gifs_ta.has-hover ? AppTheme.interactive-hover : transparent;

                                        Image {
                                            source: @image-url("../assets/x.svg");
                                            width: 10px;
                                            height: 10px;
                                            colorize: AppTheme.text-muted;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        close_gifs_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show_gif_picker = false; }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                height: 26px;

                                Rectangle {
                                    width: 76px;
                                    border-radius: 5px;
                                    background: root.gif_tab == "favorites" ? AppTheme.interactive-selected : (gif_fav_ta.has-hover ? AppTheme.interactive-hover : transparent);
                                    Text {
                                        text: Tr.gif_favorites;
                                        color: AppTheme.text-primary;
                                        font-size: TypeScale.caption;
                                        font-weight: 700;
                                    }
                                    gif_fav_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.gif_tab = "favorites";
                                            root.open_gif_picker();
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 76px;
                                    border-radius: 5px;
                                    background: root.gif_tab == "trending" ? AppTheme.interactive-selected : (gif_trend_ta.has-hover ? AppTheme.interactive-hover : transparent);
                                    Text {
                                        text: Tr.gif_trending;
                                        color: AppTheme.text-primary;
                                        font-size: TypeScale.caption;
                                        font-weight: 700;
                                    }
                                    gif_trend_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.gif_tab = "trending";
                                            root.open_gif_picker();
                                        }
                                    }
                                }

                                for term in ["hello", "lol", "love", "happy birthday"]: Rectangle {
                                    width: term_text.preferred-width + 14px;
                                    border-radius: 5px;
                                    background: term_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                    term_text := Text {
                                        text: term;
                                        color: AppTheme.text-primary;
                                        font-size: TypeScale.caption;
                                        font-weight: 700;
                                    }
                                    term_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.search_gifs(term); }
                                    }
                                }
                            }

                            if root.gif_loading || root.gif_empty: Text {
                                text: root.gif_loading ? "…" : Tr.gif_none;
                                color: AppTheme.text-muted;
                                font-size: TypeScale.small;
                                horizontal-alignment: center;
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                viewport-width: self.visible-width;

                                VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for row in root.gif_rows: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        for gif in row.items: Rectangle {
                                            width: 222px;
                                            height: 130px;
                                            border-radius: 6px;
                                            background: AppTheme.interactive-muted;
                                            clip: true;

                                            if gif.has_preview: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: gif.preview;
                                                image-fit: cover;
                                            }

                                            if gif_cell_ta.has-hover: Rectangle {
                                                background: AppTheme.accent-subtle;
                                            }

                                            gif_cell_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.send_message(gif.url);
                                                    root.show_gif_picker = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

    // Stickers, in the same popup as GIFs and emoji.
    if root.show_sticker_picker: Rectangle {
        x: root.width - self.width - root.member_panel_width - 16px;
        y: root.height - self.height - 76px;
        width: 500px;
        height: 540px;
        background: AppTheme.surface-elevated;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        drop-shadow-blur: 10px;
        drop-shadow-color: AppTheme.surface-scrim;
        TouchArea {}
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            ExpressionTabs {
                active: "sticker";
                select(tab) => { root.open_expression(tab); }
            }
            LineEdit {
                placeholder-text: "Search stickers";
                edited(query) => { root.sticker_search(query); }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 6px;
                                ListView {
                                    width: 52px;
                                    for item in root.sticker_rail: Rectangle {
                                        height: 46px;
                                        Rectangle {
                                            x: 4px;
                                            y: 3px;
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 12px;
                                            background: sticker_rail_ta.has-hover || root.sticker_source == item.id ? AppTheme.interactive-selected : AppTheme.surface-input;
                                            animate background { duration: 100ms; easing: ease-out; }
                                            clip: true;
                                            if item.is_recent: Image {
                                                x: 9px;
                                                y: 9px;
                                                width: 22px;
                                                height: 22px;
                                                source: @image-url("../assets/clock.svg");
                                                colorize: AppTheme.text-secondary;
                                            }
                                            if !item.is_recent && item.has_icon: Image {
                                                width: 100%;
                                                height: 100%;
                                                source: item.icon;
                                                image-fit: cover;
                                            }
                                            if !item.is_recent && !item.has_icon: Text {
                                                text: item.initial;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.body;
                                                font-weight: 700;
                                            }
                                            sticker_rail_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.pick_sticker_source(item.id); }
                                            }
                                        }
                                    }
                                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    if root.sticker_empty: Text {
                        text: "No stickers here.";
                        color: AppTheme.text-muted;
                        font-size: TypeScale.small;
                        horizontal-alignment: center;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.sticker_rows: HorizontalLayout {
                            height: 134px;
                            spacing: 6px;
                            alignment: start;
                            for sticker in row.items: Rectangle {
                                width: 128px;
                                height: 128px;
                                border-radius: 6px;
                                background: sticker_cell_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                animate background { duration: 90ms; easing: ease-out; }
                                if sticker.has_preview: Image {
                                    x: 6px;
                                    y: 6px;
                                    width: 116px;
                                    height: 116px;
                                    source: sticker.preview;
                                    image-fit: contain;
                                    opacity: sticker.locked ? 0.35 : 1;
                                }
                                if sticker.locked: Rectangle {
                                    x: 52px;
                                    y: 52px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: AppTheme.backdrop-max;
                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        source: @image-url("../assets/lock.svg");
                                        colorize: AppTheme.solid-white;
                                    }
                                }
                                sticker_cell_ta := TouchArea {
                                    mouse-cursor: sticker.locked ? default : pointer;
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.sticker_preview_name = sticker.title;
                                            root.sticker_preview_img = sticker.preview;
                                        }
                                    }
                                    clicked => {
                                        if (!sticker.locked) {
                                            root.send_sticker(sticker.url);
                                            root.show_sticker_picker = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 32px;
                            height: 32px;
                            source: root.sticker_preview_img;
                            image-fit: contain;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.sticker_preview_name;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.body;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // @ autofill above the message bar.
    if root.show_mentions && root.mention_items.length > 0: MentionPopup {
        x: root.channel_sidebar_width + 88px;
        y: root.height - self.height - 76px;
        width: Math.max(320px, root.width - root.channel_sidebar_width - root.member_panel_width - 112px);
        items: root.mention_items;
        active: root.mention_index;
        pick(index) => { root.pick_mention(index); }
    }

    // Preview of a stream while its row in the channel list is hovered.
    Timer {
        interval: 350ms;
        running: root.stream_preview_shown && !root.stream_row_hover_active && !preview_card.hovered;
        triggered => { root.stream_preview_shown = false; }
    }

    preview_card := StreamPreviewCard {
        visible: root.stream_preview_shown;
        x: root.channel_sidebar_width + 70px;
        y: Math.max(40px, Math.min(root.stream_preview_y - 60px, root.height - self.height - 12px));
        name: root.stream_preview_name;
        preview: root.stream_preview_image;
        has_preview: root.stream_preview_has_image;
        watching: root.active_stream_user_id == root.stream_preview_uid && root.has_active_stream;
        watch => {
            root.unhide_stream(root.stream_preview_uid);
            root.stream_row_hover_active = false;
            root.stream_preview_shown = false;
            if (!root.is_voice_focused) { root.toggle_voice_focus(); }
        }
    }

    // The watched stream keeps playing small while the chat is on screen.
    if root.is_in_voice && !root.is_voice_focused && root.has_active_stream && root.active_stream_user_id != "": Rectangle {
        property <length> view_x: self.absolute-position.x;
        property <length> view_y: self.absolute-position.y;
        x: clamp(root.width - self.width - root.member_panel_width - 20px + root.pip_offset_x, 8px, Math.max(8px, root.width - self.width - 8px));
        y: clamp(root.height - self.height - 84px + root.pip_offset_y, 8px, Math.max(8px, root.height - self.height - 8px));
        width: 320px;
        height: 180px;
        z: 30;
        border-radius: 8px;
        background: root.gpu_video_main ? #010203 : AppTheme.surface-media;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        clip: true;
        init => { root.stream_viewport_changed(view_x, view_y, self.width, self.height); }
        changed view_x => { root.stream_viewport_changed(view_x, view_y, self.width, self.height); }
        changed view_y => { root.stream_viewport_changed(view_x, view_y, self.width, self.height); }
        if !root.gpu_video_main: Image {
            width: 100%;
            height: 100%;
            source: root.remote_stream_frame;
            image-fit: contain;
        }
        pip_ta := TouchArea {
            mouse-cursor: self.pressed && root.pip_dragging ? MouseCursor.grabbing : MouseCursor.pointer;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.pip_dragging = false;
                }
            }
            moved => {
                if (self.pressed) {
                    let dx = self.mouse-x - self.pressed-x;
                    let dy = self.mouse-y - self.pressed-y;
                    if (root.pip_dragging || dx > 4px || dx < -4px || dy > 4px || dy < -4px) {
                        root.pip_dragging = true;
                        root.pip_offset_x = clamp(root.pip_offset_x + dx, -root.width, root.width);
                        root.pip_offset_y = clamp(root.pip_offset_y + dy, -root.height, root.height);
                    }
                }
            }
            clicked => {
                if (!root.pip_dragging) { root.toggle_voice_focus(); }
                root.pip_dragging = false;
            }
        }
        if pip_ta.has-hover || pip_back_ta.has-hover || pip_pop_ta.has-hover || pip_stop_ta.has-hover: Rectangle {
            height: 34px;
            y: 0px;
            background: @linear-gradient(180deg, #000000c8 0%, #00000000 100%);
        }
        Text {
            x: 10px;
            y: parent.height - 26px;
            width: parent.width - 110px;
            text: root.active_stream_user;
            color: AppTheme.solid-white;
            font-size: TypeScale.small;
            font-weight: 600;
            overflow: elide;
        }
        Rectangle {
            x: 6px;
            y: 6px;
            width: 26px;
            height: 26px;
            border-radius: 4px;
            background: pip_back_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;
            Image { width: 16px; height: 16px; source: @image-url("../assets/arrow-left.svg"); colorize: AppTheme.solid-white; }
            pip_back_ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle_voice_focus(); } }
        }
        Rectangle {
            x: parent.width - 66px;
            y: parent.height - 32px;
            width: 26px;
            height: 26px;
            border-radius: 4px;
            background: pip_pop_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;
            Image { width: 15px; height: 15px; source: @image-url("../assets/popout.svg"); colorize: AppTheme.solid-white; }
            pip_pop_ta := TouchArea { mouse-cursor: pointer; clicked => { root.popout_stream_window(root.active_stream_user_id, root.active_stream_user); } }
        }
        Rectangle {
            x: parent.width - 34px;
            y: parent.height - 32px;
            width: 26px;
            height: 26px;
            border-radius: 4px;
            background: pip_stop_ta.has-hover ? AppTheme.danger-action : AppTheme.backdrop;
            Image { width: 16px; height: 16px; source: @image-url("../assets/stop-stream.svg"); colorize: AppTheme.solid-white; }
            pip_stop_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    let watched = root.active_stream_user_id;
                    root.focused_stream_uid = "";
                    root.hide_stream(watched);
                }
            }
        }
    }

    if root.message_menu_id != "": MessageMenu {
        width: 100%;
        height: 100%;
        menu-x: root.message_menu_x;
        menu-y: root.message_menu_y;
        is_own: root.message_menu_own;
        is_pinned: root.message_menu_pinned;
        can_manage: root.message_menu_can_manage;
        close => { root.message_menu_id = ""; }
        action(name) => { root.message_action(name, root.message_menu_id, "", 0px, 0px); }
    }

    if root.forward_message_id != "": ForwardPicker {
        width: 100%;
        height: 100%;
        targets: root.forward_targets;
        close => { root.forward_message_id = ""; }
        pick(id) => { root.message_action("forward_to", root.forward_message_id, id, 0px, 0px); }
    }

    if root.confirm_text != "": ConfirmDialog {
        width: 100%;
        height: 100%;
        text: root.confirm_text;
        cancel => { root.confirm_text = ""; }
        confirm => { root.message_action("confirm", root.confirm_message_id, "", 0px, 0px); }
    }

    if root.show_user_menu_popup: UserContextMenu {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        menu-x: root.user_menu_x;
        menu-y: root.user_menu_y;
        name: root.user_menu_name;
        is_self: root.user_menu_is_self;
        in_voice: root.user_menu_in_voice;
        volume <=> root.user_menu_volume;
        has_stream: root.user_menu_has_stream;
        stream_volume <=> root.user_menu_stream_volume;
        stream_volume_changed(value) => { root.set_stream_volume(root.user_menu_user_id, value); }
        muted <=> root.user_menu_muted;
        server_muted: root.user_menu_server_muted;
        server_deafened: root.user_menu_server_deafened;
        can_mute: root.user_menu_can_mute;
        can_deafen: root.user_menu_can_deafen;
        can_move: root.user_menu_can_move;
        can_kick: root.user_menu_can_kick;
        can_ban: root.user_menu_can_ban;
        can_roles: root.user_menu_can_roles;
        blocked: root.user_menu_blocked;
        sub: root.user_menu_sub;
        sub_items: root.user_menu_items;
        note <=> root.user_menu_note;
        confirm <=> root.user_menu_confirm;
        error: root.user_menu_error;
        close => { root.show_user_menu_popup = false; }
        action(name) => { root.user_menu_action(name); }
        volume_changed(value) => { root.set_user_volume(root.user_menu_user_id, value); }
        toggle_mute => { root.toggle_user_mute(root.user_menu_user_id); }
    }

    if root.channel_settings_open: ChannelSettingsScreen {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title: root.channel_settings_title;
        is_voice: root.channel_settings_is_voice;
        is_category: root.channel_settings_is_category;
        tab: root.channel_settings_tab;
        name <=> root.channel_settings_name;
        topic <=> root.channel_settings_topic;
        slowmode <=> root.channel_settings_slowmode;
        bitrate <=> root.channel_settings_bitrate;
        full_video <=> root.channel_settings_full_video;
        is_private <=> root.channel_settings_private;
        saved_name: root.channel_settings_saved_name;
        saved_topic: root.channel_settings_saved_topic;
        saved_slowmode: root.channel_settings_saved_slowmode;
        saved_bitrate: root.channel_settings_saved_bitrate;
        saved_full_video: root.channel_settings_saved_full_video;
        saved_private: root.channel_settings_saved_private;
        rows: root.channel_settings_rows;
        status: root.channel_settings_status;
        error: root.channel_settings_error;
        busy: root.channel_settings_busy;
        close => { root.channel_settings_open = false; }
        pick_tab(name) => { root.channel_action("tab", name, 0px, 0px); }
        save => { root.channel_action("save", "", 0px, 0px); }
        reset => { root.channel_action("reset", "", 0px, 0px); }
        ask_delete => { root.channel_action("ask_delete", root.channel_settings_id, 0px, 0px); }
        remove_row(id) => { root.channel_action("ask_revoke", id, 0px, 0px); }
    }

    if root.create_channel_open: CreateChannelDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        category: root.create_channel_category;
        kind <=> root.create_channel_kind;
        name <=> root.create_channel_name;
        is_private <=> root.create_channel_private;
        error: root.create_channel_error;
        busy: root.create_channel_busy;
        close => { root.create_channel_open = false; }
        create => { root.channel_action("create_submit", "", 0px, 0px); }
    }

    if root.invite_open: InviteDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        channel: root.invite_channel;
        link: root.invite_link;
        status: root.invite_status;
        close => { root.invite_open = false; }
        copy => { root.channel_action("copy_invite", "", 0px, 0px); }
    }

    if root.channel_menu_open: ChannelMenu {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        menu-x: root.channel_menu_x;
        menu-y: root.channel_menu_y;
        channel_id: root.channel_menu_id;
        is_voice: root.channel_menu_is_voice;
        is_category: root.channel_menu_is_category;
        in_server: root.channel_menu_in_server;
        muted: root.channel_menu_muted;
        can_manage: root.can_manage_channels;
        can_invite: root.can_create_invite;
        close => { root.channel_menu_open = false; }
        action(name, id) => { root.channel_action(name, id, 0px, 0px); }
    }

    if root.viewer_open: ImageViewer {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: 60;
        source: root.viewer_gif && GifPlayback.id == root.viewer_id ? GifPlayback.frame : root.viewer_img;
        filename: root.viewer_name;
        close => { root.image_viewer("close"); }
        open_browser => { root.image_viewer("browser"); }
    }

    if root.channel_panel != "": ChannelPanel {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        kind: root.channel_panel;
        rows: root.channel_panel_rows;
        status: root.channel_panel_status;
        close => { root.channel_panel_action("close", "", ""); }
        pick_row(id, title) => { root.channel_panel_action("row", id, title); }
        jump(id, channel) => { root.channel_panel_action("jump", id, channel); }
        unpin(id) => { root.channel_panel_action("ask_unpin", id, ""); }
        search(query) => { root.channel_panel_action("search", query, ""); }
    }

    if root.voice_stats_open: ConnectionDetails {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        left: 80px;
        channel: root.current_voice_channel;
        ping: root.voice_stats_ping;
        average: root.voice_stats_average;
        loss: root.voice_stats_loss;
        quality: root.voice_stats_quality;
        close => { root.voice_stats_toggle(); }
    }

    if root.friends_confirm_text != "": ConfirmDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.friends_confirm_text;
        cancel => { root.friends_confirm_text = ""; }
        confirm => { root.friends_action("confirm", ""); }
    }

    if root.channel_confirm_text != "": ConfirmDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.channel_confirm_text;
        cancel => { root.channel_confirm_text = ""; }
        confirm => { root.channel_action("confirm", "", 0px, 0px); }
    }

    if root.show_user_menu: Rectangle {
        background: AppTheme.backdrop-soft;
        width: 100%;
        height: 100%;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.show_user_menu = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 350px;
                    background: AppTheme.surface-sidebar;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: AppTheme.backdrop;

                    TouchArea {
                        clicked => {}
                    }

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        // Header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: Tr.manage_accounts;
                                color: AppTheme.text-strong;
                                font-size: TypeScale.title;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: close_menu_touch.has-hover ? AppTheme.surface-control-hover : transparent;
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/x.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppTheme.text-primary;
                                        }
                                    }
                                }
                                close_menu_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show_user_menu = false; }
                                }
                            }
                        }

                        Text {
                            text: Tr.manage_accounts_desc;
                            color: AppTheme.text-muted;
                            font-size: TypeScale.caption;
                            wrap: word-wrap;
                        }

                        // List of Saved Accounts
                        VerticalBox {
                            padding: 0px;
                            spacing: 6px;

                            for acc in root.saved_accounts: Rectangle {
                                height: 54px;
                                background: acc.is_active ? AppTheme.surface-input : (card_info_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-elevated);
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: acc.is_active ? AppTheme.accent : AppTheme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    // Left Clickable Area (Avatar + Names)
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 10px;

                                        // Avatar circle with initials (centered vertically)
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                border-radius: 17px;
                                                background: acc.is_active ? AppTheme.accent : AppTheme.surface-control;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: acc.avatar_initials != "" ? acc.avatar_initials : "@";
                                                        color: AppTheme.text-on-accent;
                                                        font-size: TypeScale.body;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Username & Tag (centered vertically)
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: acc.username != "" ? acc.username : acc.tag;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.small;
                                                font-weight: 700;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: acc.tag;
                                                color: AppTheme.text-muted;
                                                font-size: TypeScale.micro;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }

                                        card_info_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if !acc.is_active {
                                                    root.show_user_menu = false;
                                                    root.switch_account(acc.id);
                                                }
                                            }
                                        }
                                    }

                                    // Right Action / Status Area (centered vertically)
                                    if acc.is_active: VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                text: Tr.account_connected;
                                                color: AppTheme.success;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if !acc.is_active: VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            // Switch button (centered vertically)
                                            Rectangle {
                                                width: 62px;
                                                height: 28px;
                                                background: sw_btn.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                                                border-radius: 4px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: Tr.account_sign_in;
                                                        color: AppTheme.text-on-accent;
                                                        font-size: TypeScale.caption;
                                                        font-weight: 600;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                sw_btn := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.show_user_menu = false;
                                                        root.switch_account(acc.id);
                                                    }
                                                }
                                            }

                                            // Remove single account trash button (centered vertically)
                                            Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                        background: del_btn.has-hover ? AppTheme.danger-action-muted : transparent;
                                                border-radius: 4px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/x.svg");
                                                            width: 12px;
                                                            height: 12px;
                                                            colorize: del_btn.has-hover ? AppTheme.danger : AppTheme.text-muted;
                                                        }
                                                    }
                                                }

                                                del_btn := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.remove_account(acc.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Add new account button
                        Rectangle {
                            height: 36px;
                            background: add_acc_touch.has-hover ? AppTheme.surface-control-hover : AppTheme.surface-chat;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: AppTheme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: Tr.add_account;
                                    color: AppTheme.accent;
                                    font-size: TypeScale.small;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            add_acc_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show_user_menu = false;
                                    root.add_new_account();
                                }
                            }
                        }

                        // Separator
                        Rectangle {
                            height: 1px;
                            background: AppTheme.border-subtle;
                        }

                        // Bottom Actions
                        HorizontalBox {
                            spacing: 8px;
                            padding: 0px;

                            // Sair de Todas as Contas Button (Danger Red / Logout)
                            Rectangle {
                                height: 32px;
                                horizontal-stretch: 1;
                                background: logout_btn_touch.has-hover ? AppTheme.danger-action-hover : AppTheme.danger-action;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/log-out.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: AppTheme.text-on-accent;
                                            image-fit: contain;
                                        }
                                    }

                                    Text {
                                        text: Tr.sign_out_all;
                                        color: AppTheme.text-on-accent;
                                        font-size: TypeScale.small;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                logout_btn_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show_user_menu = false;
                                        root.logout();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Window Drag Resize Borders & Corner Handles (on PointerEventKind.down for 0-latency instant resize)
    // Disabled when window is maximized so all titlebar buttons and edge pixels reach window controls
    // Left edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 12px;
        width: 7px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("left");
            }
        }
    }
    // Right edge (starts below titlebar at y: 32px so titlebar close button is never obstructed)
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 7px;
        y: 32px;
        width: 7px;
        height: parent.height - 44px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("right");
            }
        }
    }
    // Top edge (stops before window control buttons on the top right)
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: 0px;
        width: parent.width - (root.show_hardware_monitor ? 390px : 176px) - 12px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top");
            }
        }
    }
    // Bottom edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: parent.height - 7px;
        width: parent.width - 24px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom");
            }
        }
    }
    // Top-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 0px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-left");
            }
        }
    }
    // Bottom-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-left");
            }
        }
    }
    // Bottom-Right Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-right");
            }
        }
    }
    // Top-Right Corner (Only active when unmaximized for normal window resizing)
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 7px;
        y: 0px;
        width: 7px;
        height: 7px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-right");
            }
        }
    }

    // Modal Update Available Dialog
    if root.show_update_dialog: Rectangle {
        background: AppTheme.backdrop;
        width: 100%;
        height: 100%;
        z: 9999;

        TouchArea {
            // Block background click events
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 440px;
                    background: AppTheme.surface-sidebar;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: AppTheme.backdrop;

                    VerticalBox {
                        padding: 24px;
                        spacing: 16px;

                        // Header Icon and Title
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;

                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: AppTheme.accent-subtle;

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("../assets/rocket.svg");
                                    width: 20px;
                                    height: 20px;
                                    colorize: AppTheme.accent;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: Tr.update_available;
                                    color: AppTheme.text-strong;
                                    font-size: TypeScale.title;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Litecord " + root.update_version;
                                    color: AppTheme.success;
                                    font-size: TypeScale.body;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Body Description
                        Text {
                            text: root.is_updating ? root.update_status_text : Tr.update_prompt;
                            color: AppTheme.text-secondary;
                            font-size: TypeScale.body;
                            wrap: word-wrap;
                        }

                        // Progress Bar (when downloading)
                        if root.is_updating: VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 8px;
                                background: AppTheme.surface-input;
                                border-radius: 4px;
                                clip: true;

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    height: 8px;
                                    width: root.update_progress * parent.width;
                                    background: AppTheme.success;
                                    border-radius: 4px;
                                }
                            }

                            Text {
                                text: Math.round(root.update_progress * 100) + "%";
                                color: AppTheme.text-subtle;
                                font-size: TypeScale.caption;
                                horizontal-alignment: right;
                            }
                        }

                        // Action Buttons
                        if !root.is_updating: HorizontalLayout {
                            spacing: 10px;

                            // Não Mostrar Mais (Ignore)
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: ignore_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: AppTheme.separator;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: Tr.dont_show_again;
                                        color: AppTheme.text-muted;
                                        font-size: TypeScale.small;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }

                                ignore_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.update_app_ignore(); }
                                }
                            }

                            // Lembrar Depois (Não)
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: dismiss_touch.has-hover ? AppTheme.surface-control-hover : AppTheme.interactive-hover;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: Tr.remind_later;
                                        color: AppTheme.text-primary;
                                        font-size: TypeScale.small;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                dismiss_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.update_app_dismiss(); }
                                }
                            }

                            // Sim, Atualizar
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: accept_touch.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: Tr.yes_update;
                                        color: AppTheme.text-on-accent;
                                        font-size: TypeScale.small;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                accept_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.update_app_accept(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Community onboarding questionnaire.
    if root.show_onboarding_modal: OnboardingView {
        guild_name: root.onboarding_guild_name;
        prompts: root.onboarding_prompts;
        submitting: root.onboarding_submitting;
        error_text: root.onboarding_error;
        toggle_option(prompt, option) => { root.onboarding_toggle(prompt, option); }
        submit => { root.onboarding_submit(); }
        dismiss => { root.onboarding_dismiss(); }
    }

    // Web sharing: the link to send to whoever will watch in a browser.
    if root.show_web_share_modal && root.web_share_active: Rectangle {
        background: AppTheme.backdrop;
        width: 100%;
        height: 100%;
        z: 9999;

        TouchArea {
            clicked => { root.show_web_share_modal = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 460px;
                    background: AppTheme.surface-sidebar;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: AppTheme.backdrop;

                    // Clicks inside the window do not close it.
                    TouchArea { }

                    VerticalBox {
                        padding: 24px;
                        spacing: 16px;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;

                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: AppTheme.accent-subtle;

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("../assets/globe.svg");
                                    width: 20px;
                                    height: 20px;
                                    colorize: AppTheme.accent;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: Tr.web_share_title;
                                    color: AppTheme.text-strong;
                                    font-size: TypeScale.title;
                                    font-weight: 700;
                                }

                                Text {
                                    text: root.web_share_viewers + "/3 " + Tr.web_share_watching;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.small;
                                }
                            }
                        }

                        Text {
                            text: Tr.web_share_hint;
                            color: AppTheme.text-secondary;
                            font-size: TypeScale.body;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 40px;
                            background: AppTheme.surface-input;
                            border-radius: 6px;
                            clip: true;

                            TextInput {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                vertical-alignment: center;
                                text: root.web_share_url;
                                read-only: true;
                                single-line: true;
                                color: AppTheme.text-primary;
                                font-size: TypeScale.small;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: web_stop_touch.has-hover ? AppTheme.danger-action-subtle : AppTheme.surface-sidebar;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: AppTheme.separator;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: Tr.web_share_stop;
                                        color: AppTheme.danger;
                                        font-size: TypeScale.small;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                web_stop_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show_web_share_modal = false;
                                        root.toggle_web_share();
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: web_close_touch.has-hover ? AppTheme.surface-control-hover : AppTheme.interactive-hover;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: Tr.close;
                                        color: AppTheme.text-primary;
                                        font-size: TypeScale.small;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                web_close_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show_web_share_modal = false; }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: web_copy_touch.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.web_share_copied ? Tr.web_share_copied : Tr.web_share_copy;
                                        color: AppTheme.text-on-accent;
                                        font-size: TypeScale.small;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                web_copy_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.copy_web_share_link(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // DISCORD-STYLE SCREEN SHARE SELECTION MODAL
    // ==========================================
    if root.show_stream_modal: Rectangle {
        background: AppTheme.backdrop;
        width: 100%;
        height: 100%;

        // Dismiss when clicking outer backdrop
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.show_stream_modal = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 500px;
                    background: AppTheme.surface-chat;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: AppTheme.backdrop;
                    clip: true;

                    TouchArea {
                        clicked => {}
                    }

                    VerticalBox {
                        padding: 0px;
                        spacing: 0px;

                        // 1. Modal Header
                        Rectangle {
                            height: 52px;
                            background: AppTheme.surface-chat;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: Tr.share_your_screen;
                                        color: AppTheme.text-strong;
                                        font-size: TypeScale.title;
                                        font-weight: 700;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: close_modal_ta.has-hover ? AppTheme.interactive-hover : transparent;

                                        Image {
                                            source: @image-url("../assets/chrome-close.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppTheme.text-secondary;
                                            image-fit: contain;
                                        }

                                        close_modal_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show_stream_modal = false; }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Tabs Bar (Captura de Tela vs Captura de Janela)
                        Rectangle {
                            height: 38px;
                            background: AppTheme.surface-sidebar;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 24px;

                                // Tab: Telas (Captura de Tela)
                                Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/monitor.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "screens" ? AppTheme.text-strong : AppTheme.text-muted;
                                            }
                                            Text {
                                                text: root.is_linux ? Tr.screens_windows : Tr.screens;
                                                color: root.stream_source_tab == "screens" ? AppTheme.text-strong : AppTheme.text-muted;
                                                font-size: TypeScale.body;
                                                font-weight: root.stream_source_tab == "screens" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "screens": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: AppTheme.accent;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "screens";
                                            root.stream_selected_source_index = 0;
                                            root.stream_selected_window_id = "";
                                            root.stream_include_audio = true;
                                        }
                                    }
                                }

                                // Tab: Janelas (Captura de Janela apenas no Windows)
                                if !root.is_linux: Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/window.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "windows" ? AppTheme.text-strong : AppTheme.text-muted;
                                            }
                                            Text {
                                                text: Tr.windows_tab;
                                                color: root.stream_source_tab == "windows" ? AppTheme.text-strong : AppTheme.text-muted;
                                                font-size: TypeScale.body;
                                                font-weight: root.stream_source_tab == "windows" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "windows": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: AppTheme.accent;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "windows";
                                            root.stream_selected_source_index = 0;
                                            root.stream_include_audio = true;
                                            if root.available_windows.length > 0 {
                                                root.stream_selected_window_id = root.available_windows[0].id;
                                            }
                                        }
                                    }
                                }

                                // Tab: Câmera (Webcam)
                                Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/camera.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "cameras" ? AppTheme.text-strong : AppTheme.text-muted;
                                            }
                                            Text {
                                                text: Tr.camera;
                                                color: root.stream_source_tab == "cameras" ? AppTheme.text-strong : AppTheme.text-muted;
                                                font-size: TypeScale.body;
                                                font-weight: root.stream_source_tab == "cameras" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "cameras": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: AppTheme.accent;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "cameras";
                                            root.stream_selected_source_index = 0;
                                            root.stream_include_audio = false;
                                            if root.available_cameras.length > 0 {
                                                root.stream_selected_camera_id = root.available_cameras[0].id;
                                            }
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        // 3. Source Selection Preview Area
                        VerticalBox {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 14px;

                            // Source Cards (Telas vs Janelas)
                            if root.stream_source_tab == "screens": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for scr[idx] in root.available_screens: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? AppTheme.accent-subtle : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.border-subtle;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            // Screen Illustration Box
                                            Rectangle {
                                                height: 52px;
                                                background: AppTheme.surface-input;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? AppTheme.accent-border-muted : AppTheme.border-subtle;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/monitor.svg");
                                                            width: 24px;
                                                            height: 24px;
                                                            colorize: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.text-subtle;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: root.is_linux ? Tr.screen_window : scr.name;
                                                color: root.stream_selected_source_index == idx ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: root.is_linux ? Tr.system_portal : scr.resolution;
                                                color: AppTheme.text-subtle;
                                                font-size: TypeScale.micro;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_window_id = "";
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.is_linux && root.stream_source_tab == "windows": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for win[idx] in root.available_windows: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? AppTheme.accent-subtle : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.border-subtle;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            Rectangle {
                                                height: 52px;
                                                background: AppTheme.surface-input;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? AppTheme.accent-border-muted : AppTheme.border-subtle;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: win.has_icon ? win.icon_image : (win.app_name == "Litecord" ? @image-url("../assets/app_icon.png") : (win.app_name == "Google Chrome" ? @image-url("../assets/globe.svg") : @image-url("../assets/window.svg")));
                                                            width: 28px;
                                                            height: 28px;
                                                            colorize: win.has_icon || win.app_name == "Litecord" ? transparent : (root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.text-subtle);
                                                            image-fit: contain;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: win.title;
                                                color: root.stream_selected_source_index == idx ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: win.app_name;
                                                color: AppTheme.text-subtle;
                                                font-size: TypeScale.micro;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_window_id = win.id;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "cameras": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for cam[idx] in root.available_cameras: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? AppTheme.accent-subtle : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.border-subtle;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            Rectangle {
                                                height: 52px;
                                                background: AppTheme.surface-input;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? AppTheme.accent-border-muted : AppTheme.border-subtle;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/camera.svg");
                                                            width: 24px;
                                                            height: 24px;
                                                            colorize: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.text-subtle;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: cam.name;
                                                color: root.stream_selected_source_index == idx ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: "Webcam";
                                                color: AppTheme.text-subtle;
                                                font-size: TypeScale.micro;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_camera_id = cam.id;
                                            }
                                        }
                                    }

                                    if root.available_cameras.length == 0: Rectangle {
                                        width: 440px;
                                        height: 110px;
                                        background: AppTheme.surface-sidebar;
                                        border-radius: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: Tr.no_camera;
                                                color: AppTheme.text-muted;
                                                font-size: TypeScale.small;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // 4. Stream Quality Section (Displayed ONLY for Screens and Windows, as Cameras use their optimal native sensor stream)
                            if root.stream_source_tab != "cameras": Text {
                                text: Tr.stream_quality;
                                color: AppTheme.text-secondary;
                                font-size: TypeScale.caption;
                                font-weight: 800;
                            }

                            // Resolution Selection (1080p, 720p, 480p)
                            if root.stream_source_tab != "cameras": VerticalBox {
                                padding: 0px;
                                spacing: 6px;

                                Text {
                                    text: Tr.resolution;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.micro;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;

                                    // 1440p (2560x1440)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "1440p" ? AppTheme.accent : (res_1440_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "1440p" ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "1440p";
                                                color: root.stream_selected_res == "1440p" ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_1440_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "1440p"; }
                                        }
                                    }

                                    // 1080p (1920x1080)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "1080p" ? AppTheme.accent : (res_1080_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "1080p" ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "1080p (1920×1080)";
                                                color: root.stream_selected_res == "1080p" ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_1080_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "1080p"; }
                                        }
                                    }

                                    // 720p (1280x720)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "720p" ? AppTheme.accent : (res_720_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "720p" ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "720p (1280×720)";
                                                color: root.stream_selected_res == "720p" ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_720_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "720p"; }
                                        }
                                    }

                                    // 480p (854x480)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "480p" ? AppTheme.accent : (res_480_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "480p" ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "480p (854×480)";
                                                color: root.stream_selected_res == "480p" ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_480_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "480p"; }
                                        }
                                    }
                                }
                            }

                            // Framerate Selection (60 FPS, 30 FPS, 15 FPS)
                            if root.stream_source_tab != "cameras": VerticalBox {
                                padding: 0px;
                                spacing: 6px;

                                Text {
                                    text: Tr.frame_rate;
                                    color: AppTheme.text-muted;
                                    font-size: TypeScale.micro;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;

                                    // 60 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 60 ? AppTheme.accent : (fps_60_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 60 ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "60 FPS";
                                                color: root.stream_selected_fps == 60 ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_60_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 60; }
                                        }
                                    }

                                    // 30 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 30 ? AppTheme.accent : (fps_30_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 30 ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "30 FPS";
                                                color: root.stream_selected_fps == 30 ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_30_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 30; }
                                        }
                                    }

                                    // 15 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 15 ? AppTheme.accent : (fps_15_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 15 ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "15 FPS";
                                                color: root.stream_selected_fps == 15 ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: TypeScale.caption;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_15_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 15; }
                                        }
                                    }
                                }
                            }

                            // Camera Info Note (Single sleek note only when cameras exist)
                            if root.stream_source_tab == "cameras" && root.available_cameras.length > 0: Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 44px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/camera.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: AppTheme.accent;
                                            image-fit: contain;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: Tr.webcam_native;
                                            color: AppTheme.text-muted;
                                            font-size: TypeScale.caption;
                                        }
                                    }
                                }
                            }

                            // 5. Stream Audio Toggle Section (Disabled/informational for Cameras)
                            if root.stream_source_tab != "cameras": Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: root.stream_include_audio ? @image-url("../assets/speaker.svg") : @image-url("../assets/volume-x.svg");
                                                width: 18px;
                                                height: 18px;
                                                colorize: root.stream_include_audio ? AppTheme.accent : AppTheme.text-subtle;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: Tr.stream_pc_audio;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.small;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: Tr.stream_pc_audio_desc;
                                                color: AppTheme.text-muted;
                                                font-size: TypeScale.micro;
                                            }
                                        }
                                    }

                                    // Switch Toggle Button
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 40px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: root.stream_include_audio ? AppTheme.success : AppTheme.surface-control;

                                            // Knob
                                            Rectangle {
                                                x: root.stream_include_audio ? 20px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: AppTheme.solid-white;
                                                animate x { duration: 150ms; easing: ease-out; }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.stream_include_audio = !root.stream_include_audio;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "windows": Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/globe.svg");
                                                width: 18px;
                                                height: 18px;
                                                colorize: AppTheme.accent;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: Tr.browser_stream;
                                                color: AppTheme.text-strong;
                                                font-size: TypeScale.small;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: Tr.browser_stream_desc;
                                                color: AppTheme.text-muted;
                                                font-size: TypeScale.micro;
                                            }
                                        }
                                    }

                                    // Launch Button
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 4px;
                                            background: stream_browser_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent;

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 6px;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../assets/external-link.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        colorize: AppTheme.text-on-accent;
                                                        image-fit: contain;
                                                    }
                                                }

                                                Text {
                                                    text: Tr.open;
                                                    color: AppTheme.text-on-accent;
                                                    font-size: TypeScale.small;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            stream_browser_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.launch_stream_browser();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "cameras": Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/camera.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: AppTheme.accent;
                                            image-fit: contain;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: Tr.direct_camera;
                                            color: AppTheme.text-strong;
                                            font-size: TypeScale.small;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: Tr.direct_camera_desc;
                                            color: AppTheme.text-muted;
                                            font-size: TypeScale.micro;
                                        }
                                    }
                                }
                            }
                        }

                        // 6. Pinned Modal Footer Action Bar
                        Rectangle {
                            height: 60px;
                            background: AppTheme.surface-sidebar;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 12px;
                                alignment: space-between;

                                // Cancelar Button
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 4px;
                                        background: modal_cancel_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text {
                                                text: Tr.cancel;
                                                color: AppTheme.text-primary;
                                                font-size: TypeScale.body;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }

                                        modal_cancel_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show_stream_modal = false; }
                                        }
                                    }
                                }

                                // Transmitir Button
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 4px;
                                        background: modal_start_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent;

                                        HorizontalLayout {
                                            alignment: center;
                                            padding-left: 18px;
                                            padding-right: 18px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: root.stream_source_tab == "cameras" ? @image-url("../assets/camera.svg") : (root.stream_source_tab == "windows" ? @image-url("../assets/window.svg") : @image-url("../assets/monitor.svg"));
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: AppTheme.text-on-accent;
                                                    image-fit: contain;
                                                }
                                            }

                                            Text {
                                                text: Tr.start_stream;
                                                color: AppTheme.text-on-accent;
                                                font-size: TypeScale.body;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        modal_start_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.show_stream_modal = false;
                                                root.toggle_screen_share();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Incoming DM Call Notification Panel ───────────────────────────────────────
    if root.has_incoming_call: Rectangle {
        x: parent.width - 320px - 20px;
        y: parent.height - 140px - 20px;
        width: 320px;
        height: 140px;
        border-radius: 12px;
        background: AppTheme.surface-sidebar;
        border-width: 1px;
        border-color: AppTheme.separator;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000060;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header: icon + caller name
            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: AppTheme.accent;

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/phone.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: AppTheme.text-on-accent;
                                    image-fit: contain;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Tr.incoming_call;
                        color: AppTheme.text-muted;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                    }
                    Text {
                        text: root.incoming_call_caller_name;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.title;
                        font-weight: 700;
                        overflow: elide;
                    }
                }
            }

            // Buttons: Accept (green) | Reject (red)
            HorizontalLayout {
                spacing: 8px;

                // Accept button
                Rectangle {
                    height: 36px;
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: ic_accept_ta.pressed ? #1a7a2e : (ic_accept_ta.has-hover ? #27ae60 : #2ecc71);
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/phone.svg");
                                width: 14px; height: 14px;
                                colorize: #ffffff;
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: Tr.answer;
                                color: #ffffff;
                                font-size: TypeScale.body;
                                font-weight: 700;
                            }
                        }
                    }
                    ic_accept_ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.accept_call(); }
                    }
                }

                // Reject button
                Rectangle {
                    height: 36px;
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: ic_reject_ta.pressed ? #8b0000 : (ic_reject_ta.has-hover ? #c0392b : #ed4245);
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/phone-slash.svg");
                                width: 14px; height: 14px;
                                colorize: #ffffff;
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: Tr.decline;
                                color: #ffffff;
                                font-size: TypeScale.body;
                                font-weight: 700;
                            }
                        }
                    }
                    ic_reject_ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.reject_call(); }
                    }
                }
            }
        }
    }

    // ── Fullscreen stream view ───────────────────────────────────────────────────
    // Covers the whole window; the Rust side also asks winit for real (borderless)
    // fullscreen, so this works the same on X11, Wayland, Windows and macOS.
    if root.is_stream_fullscreen && (root.has_active_stream || root.is_screen_sharing) && root.is_in_voice: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        property <bool> showing_self: root.is_screen_sharing
            && (!root.has_active_stream || root.focused_stream_uid == "self" || root.active_stream_user_id == "self");
        property <bool> gpu_hole: root.gpu_video_main && !showing_self;
        background: gpu_hole ? #010203 : #000000;
        init => { if (!showing_self) { root.stream_viewport_changed(0px, 0px, self.width, self.height); } }
        changed width => { if (!showing_self) { root.stream_viewport_changed(0px, 0px, self.width, self.height); } }
        changed height => { if (!showing_self) { root.stream_viewport_changed(0px, 0px, self.width, self.height); } }

        // Esc leaves fullscreen; Rust restores the window through the same callback.
        fs_focus := FocusScope {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.toggle_stream_fullscreen();
                    return accept;
                }
                reject
            }
        }

        if !gpu_hole: Image {
            width: 100%;
            height: 100%;
            source: showing_self ? root.active_stream_frame : root.remote_stream_frame;
            image-fit: contain;
        }

        // Exit bar
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 44px;
            background: AppTheme.surface-media-overlay-strong;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.active_stream_user;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.title;
                        font-weight: 700;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.remote_stream_fps;
                        color: AppTheme.text-muted;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                    }
                }

                Rectangle {
                    width: 34px;
                    height: 28px;
                    border-radius: 4px;
                    background: fs_exit_ta.has-hover ? AppTheme.danger : AppTheme.backdrop;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-restore.svg");
                                width: 12px;
                                height: 12px;
                                colorize: AppTheme.text-on-accent;
                                image-fit: contain;
                            }
                        }
                    }

                    fs_exit_ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle_stream_fullscreen(); }
                    }
                }
            }
        }
    }
}

// Popout Detached Video Window Component
export component PopoutStreamWindow inherits Window {
    title: Tr.detached_title;
    no-frame: true;
    // The GPU draws the stream under the window: the hole colour leaves it transparent.
    in property <bool> gpu_video: false;
    background: root.gpu_video ? #010203 : AppTheme.surface-media;
    preferred-width: 640px;
    preferred-height: 360px;
    min-width: 180px;
    min-height: 100px;
    default-font-family: TypeScale.family;

    // Visual boundary border
    Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: AppTheme.surface-sidebar;
    }

    in-out property <image> stream_frame;
    in-out property <string> username: Tr.stream_word;
    in-out property <string> user_id: "";
    in-out property <string> stream_fps: "";
    in-out property <float> stream_volume: 1.0;
    in-out property <bool> is_pinned: false;
    in-out property <bool> is_intangible: false;
    in-out property <bool> show_controls: true;
    in-out property <bool> is_maximized: false;
    in-out property <bool> drag_area_enabled: true;
    in-out property <bool> is_linux: false;
    in-out property <bool> is_self: false;
    in-out property <bool> show_self_preview_notice: false;

    callback toggle_pin();
    callback toggle_intangible();
    callback start_window_drag();
    callback toggle_fullscreen();
    callback close_popout();
    callback minimize_popout();
    callback drag_resize(string);
    callback mouse_activity();
    callback stream_volume_changed(string, float);
    // Every place that closes the popout clears user_id, so this tells whether it shows a stream.
    callback user_id_changed(string);
    changed user_id => {
        root.user_id_changed(root.user_id);
    }

    // Global mouse activity tracker
    TouchArea {
        pointer-event(event) => {
            root.mouse_activity();
        }
    }

    // Video Canvas Viewport
    if !root.gpu_video: Image {
        width: 100%;
        height: 100%;
        source: root.stream_frame;
        image-fit: contain;
    }

    // Top Autohiding Controls Bar (Discord Floating Overlay Style)
    if root.show_controls: Rectangle {
        y: 8px;
        x: 8px;
        width: parent.width - 16px;
        height: 38px;
        background: AppTheme.surface-media-overlay;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.surface-sidebar-overlay;
        drop-shadow-blur: 8px;
        drop-shadow-color: AppTheme.backdrop-soft;

        // Background Drag Handle (placed first so buttons on top receive clicks!)
        if root.drag_area_enabled: TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                root.mouse_activity();
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.start_window_drag();
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            alignment: space-between;

            // Left Side: Live Badge & Username Pill & Dynamic Volume Slider (Vertically Centered)
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Live Badge (hides when width <= 340px)
                if root.width > 340px : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        background: AppTheme.danger;
                        border-radius: 4px;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: AppTheme.solid-white;
                                }
                            }
                            Text {
                                text: Tr.live_badge;
                                color: AppTheme.text-on-accent;
                                font-size: TypeScale.micro;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // FPS Counter Badge (Local) (hides when width <= 270px)
                if root.stream_fps != "" && root.width > 270px : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        background: AppTheme.success-subtle;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: AppTheme.success;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: AppTheme.success;
                                }
                            }
                            Text {
                                text: root.stream_fps;
                                color: AppTheme.success;
                                font-size: TypeScale.micro;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Stream Username & Tag (hides when width <= 200px)
                if root.width > 200px : VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.username;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.small;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Dynamic Volume Slider (only shown if popout width has enough space > 420px)
                if root.width > 420px : HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.stream_volume <= 0.01 ? @image-url("../assets/volume-x.svg") : @image-url("../assets/speaker.svg");
                            width: 13px;
                            height: 13px;
                            colorize: root.stream_volume <= 0.01 ? AppTheme.danger : AppTheme.text-muted;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 65px;
                            height: 6px;
                            background: AppTheme.interactive-hover;
                            border-radius: 3px;

                            // Volume fill bar
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * (root.stream_volume.clamp(0.0, 1.0));
                                height: 100%;
                                background: root.stream_volume <= 0.01 ? AppTheme.danger : AppTheme.accent;
                                border-radius: 3px;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                    root.stream_volume = new_vol;
                                    root.stream_volume_changed(root.user_id, new_vol);
                                }
                                moved => {
                                    if self.pressed {
                                        let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                        root.stream_volume = new_vol;
                                        root.stream_volume_changed(root.user_id, new_vol);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "\{Math.round(root.stream_volume * 100)}%";
                            color: AppTheme.text-muted;
                            font-size: TypeScale.micro;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Right Side: Window Control Action Buttons (Vertically Centered)
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                // Intangible / Click-Through Ghost Mode Toggle (Left of Pin)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.is_intangible ? AppTheme.success : (pop_ghost_ta.has-hover ? AppTheme.interactive-hover : transparent);

                        Image {
                            source: @image-url("../assets/ghost.svg");
                            width: 13px;
                            height: 13px;
                            colorize: root.is_intangible ? AppTheme.text-on-accent : (pop_ghost_ta.has-hover ? AppTheme.text-strong : AppTheme.text-primary);
                            image-fit: contain;
                        }

                        pop_ghost_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_intangible(); }
                        }
                    }
                }

                // Pin / Always-On-Top Toggle Button (Left of Minimize)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.is_pinned ? AppTheme.accent : (pop_pin_ta.has-hover ? AppTheme.interactive-hover : transparent);

                        Image {
                            source: @image-url("../assets/pin.svg");
                            width: 12px;
                            height: 12px;
                            colorize: root.is_pinned ? AppTheme.text-on-accent : (pop_pin_ta.has-hover ? AppTheme.text-strong : AppTheme.text-primary);
                            image-fit: contain;
                        }

                        pop_pin_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_pin(); }
                        }
                    }
                }

                // Minimize Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_min_ta.has-hover ? AppTheme.interactive-hover : transparent;

                        Image {
                            source: @image-url("../assets/chrome-minimize.svg");
                            width: 12px;
                            height: 12px;
                            colorize: AppTheme.text-primary;
                            image-fit: contain;
                        }

                        pop_min_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.minimize_popout(); }
                        }
                    }
                }

                // Fullscreen / Maximize Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_fs_ta.has-hover ? AppTheme.interactive-hover : transparent;

                        Image {
                            source: root.is_maximized ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                            width: 12px;
                            height: 12px;
                            colorize: AppTheme.text-primary;
                            image-fit: contain;
                        }

                        pop_fs_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_fullscreen(); }
                        }
                    }
                }

                // Close / Re-attach Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_close_ta.has-hover ? AppTheme.danger : transparent;

                        Image {
                            source: @image-url("../assets/chrome-close.svg");
                            width: 12px;
                            height: 12px;
                            colorize: pop_close_ta.has-hover ? AppTheme.text-on-accent : AppTheme.text-primary;
                            image-fit: contain;
                        }

                        pop_close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close_popout(); }
                        }
                    }
                }
            }
        }
    }

    // Self-Preview Resource Notice in Popout (Single compact line below AO VIVO badge)
    if (root.is_self && root.show_self_preview_notice): Rectangle {
        x: 8px;
        y: 44px;
        width: parent.width > 230px ? 215px : (parent.width - 16px > 0px ? parent.width - 16px : 0px);
        height: 20px;
        background: AppTheme.surface-media-overlay-strong;
        border-radius: 4px;
        border-width: 1px;
        border-color: AppTheme.accent-border-strong;
        clip: true;

        HorizontalLayout {
            width: 100%;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../assets/info.svg");
                    width: 11px;
                    height: 11px;
                    colorize: AppTheme.accent;
                    image-fit: contain;
                }
            }

            Text {
                text: Tr.preview_reduced;
                color: AppTheme.text-primary;
                font-size: TypeScale.micro;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.show_self_preview_notice = false; }
        }
    }

    // Window Drag Resize Borders & Corner Handles (0-latency hardware resize)
    // Left edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 12px;
        width: 8px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("left");
            }
        }
    }
    // Right edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 8px;
        y: 12px;
        width: 8px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("right");
            }
        }
    }
    // Top edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top");
            }
        }
    }
    // Bottom edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: parent.height - 8px;
        width: parent.width - 24px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom");
            }
        }
    }
    // Top-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 0px;
        width: 14px;
        height: 14px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-left");
            }
        }
    }
    // Top-Right Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 14px;
        y: 0px;
        width: 14px;
        height: 14px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-right");
            }
        }
    }
    // Bottom-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-left");
            }
        }
    }
    // Bottom-Right Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 14px;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-right");
            }
        }
    }
}
