import { LineEdit, ScrollView } from "std-widgets.slint";
import { AppTheme, TypeScale } from "../theme.slint";

export struct MessageReaction {
    key: string,
    label: string,
    emoji_id: string,
    img: image,
    has_img: bool,
    count: int,
    me: bool,
}

export struct MentionItem {
    user_id: string,
    name: string,
    subtitle: string,
    avatar_text: string,
}

export struct ForwardTarget {
    id: string,
    name: string,
}

component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked(length, length);
    width: 30px;
    height: 30px;
    border-radius: 4px;
    accessible-role: button;
    accessible-label: label;
    background: ta.has-hover ? AppTheme.interactive-selected : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    Image {
        x: 6px;
        y: 6px;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: ta.has-hover ? AppTheme.text-strong : AppTheme.text-secondary;
        image-fit: contain;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y + self.height); }
    }
}

component EmojiButton inherits Rectangle {
    in property <MessageReaction> emoji;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 4px;
    accessible-role: button;
    accessible-label: emoji.label;
    background: ta.has-hover ? AppTheme.interactive-selected : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    if root.emoji.has_img: Image {
        x: 5px;
        y: 5px;
        width: 20px;
        height: 20px;
        source: root.emoji.img;
        image-fit: contain;
    }
    if !root.emoji.has_img: Text {
        text: root.emoji.label;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MessageToolbar inherits Rectangle {
    in property <[MessageReaction]> quick;
    in property <bool> is_own;
    out property <bool> hovered: bar_ta.has-hover;
    callback action(string, string, length, length);

    width: row.preferred-width;
    height: 36px;
    border-radius: 6px;
    background: AppTheme.surface-elevated;
    border-width: 1px;
    border-color: AppTheme.border-subtle;
    drop-shadow-blur: 6px;
    drop-shadow-color: AppTheme.surface-scrim;

    bar_ta := TouchArea {
        row := HorizontalLayout {
            padding: 2px;
            spacing: 1px;
            for emoji in root.quick: EmojiButton {
                emoji: emoji;
                clicked => { root.action("react", emoji.key, 0px, 0px); }
            }
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 3px;
                padding-right: 3px;
                Rectangle { width: 1px; background: AppTheme.separator; }
            }
            ToolButton {
                icon: @image-url("../../assets/emoji.svg");
                label: "Add Reaction";
                clicked(x, y) => { root.action("add_reaction", "", x, y); }
            }
            if root.is_own: ToolButton {
                icon: @image-url("../../assets/edit.svg");
                label: "Edit";
                clicked(x, y) => { root.action("edit", "", x, y); }
            }
            if !root.is_own: ToolButton {
                icon: @image-url("../../assets/reply.svg");
                label: "Reply";
                clicked(x, y) => { root.action("reply", "", x, y); }
            }
            ToolButton {
                icon: @image-url("../../assets/forward.svg");
                label: "Forward";
                clicked(x, y) => { root.action("forward", "", x, y); }
            }
            ToolButton {
                icon: @image-url("../../assets/more.svg");
                label: "More";
                clicked(x, y) => { root.action("more", "", x, y); }
            }
        }
    }
}

export component ReactionPill inherits Rectangle {
    in property <MessageReaction> reaction;
    callback clicked();
    height: 24px;
    width: pill.preferred-width;
    border-radius: 8px;
    background: reaction.me ? AppTheme.accent-faint : (ta.has-hover ? AppTheme.interactive-selected : AppTheme.surface-elevated);
    border-width: 1px;
    border-color: reaction.me ? AppTheme.accent : (ta.has-hover ? AppTheme.border-subtle : transparent);
    animate background { duration: 100ms; easing: ease-out; }
    pill := HorizontalLayout {
        padding-left: 6px;
        padding-right: 7px;
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            if root.reaction.has_img: Image {
                width: 16px;
                height: 16px;
                source: root.reaction.img;
                image-fit: contain;
            }
            if !root.reaction.has_img: Text {
                text: root.reaction.label;
                font-size: 13px;
            }
        }
        Text {
            text: root.reaction.count;
            color: root.reaction.me ? AppTheme.accent-soft : AppTheme.text-secondary;
            font-size: TypeScale.caption;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PopupRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: ta.has-hover ? (root.danger ? AppTheme.danger-action : AppTheme.interactive-selected) : transparent;
    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: ta.has-hover && root.danger ? AppTheme.text-on-accent : (root.danger ? AppTheme.danger : AppTheme.text-primary);
        font-size: TypeScale.small;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MessageMenu inherits Rectangle {
    in property <length> menu-x;
    in property <length> menu-y;
    in property <bool> is_own;
    in property <bool> is_pinned;
    in property <bool> can_manage;
    callback close();
    callback action(string);

    TouchArea { clicked => { root.close(); } }

    Rectangle {
        x: Math.max(8px, Math.min(root.menu-x - self.width + 30px, root.width - self.width - 8px));
        y: Math.max(8px, Math.min(root.menu-y + 4px, root.height - self.height - 8px));
        width: 210px;
        height: list.preferred-height;
        border-radius: 8px;
        background: AppTheme.surface-elevated;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        drop-shadow-blur: 12px;
        drop-shadow-color: AppTheme.surface-scrim;
        TouchArea { }
        list := VerticalLayout {
            padding: 6px;
            spacing: 1px;
            PopupRow { text: "Copy Text"; clicked => { root.action("copy_text"); } }
            PopupRow { text: "Copy Message Link"; clicked => { root.action("copy_link"); } }
            PopupRow { text: "Copy Message ID"; clicked => { root.action("copy_id"); } }
            if root.can_manage && !root.is_pinned: PopupRow { text: "Pin Message"; clicked => { root.action("pin"); } }
            if root.can_manage && root.is_pinned: PopupRow { text: "Unpin Message"; danger: true; clicked => { root.action("ask_unpin"); } }
            if root.is_own || root.can_manage: PopupRow { text: "Delete Message"; danger: true; clicked => { root.action("ask_delete"); } }
        }
    }
}

export component ConfirmDialog inherits Rectangle {
    in property <string> text;
    callback cancel();
    callback confirm();
    background: AppTheme.backdrop-soft;
    TouchArea { clicked => { root.cancel(); } }
    Rectangle {
        width: 420px;
        height: box.preferred-height;
        border-radius: 8px;
        background: AppTheme.surface-elevated;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        TouchArea { }
        box := VerticalLayout {
            padding: 20px;
            spacing: 18px;
            Text {
                text: root.text;
                color: AppTheme.text-strong;
                font-size: TypeScale.title;
                font-weight: 600;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Rectangle {
                    width: 88px;
                    height: 36px;
                    border-radius: 6px;
                    background: cancel_ta.has-hover ? AppTheme.interactive-selected : AppTheme.interactive-muted;
                    Text { text: "Cancel"; color: AppTheme.text-strong; font-size: TypeScale.small; font-weight: 600; }
                    cancel_ta := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
                }
                Rectangle {
                    width: 88px;
                    height: 36px;
                    border-radius: 6px;
                    background: ok_ta.has-hover ? AppTheme.danger-action-hover : AppTheme.danger-action;
                    Text { text: "Confirm"; color: AppTheme.text-on-accent; font-size: TypeScale.small; font-weight: 600; }
                    ok_ta := TouchArea { mouse-cursor: pointer; clicked => { root.confirm(); } }
                }
            }
        }
    }
}

export component ForwardPicker inherits Rectangle {
    in property <[ForwardTarget]> targets;
    callback close();
    callback pick(string);
    background: AppTheme.backdrop-soft;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: 420px;
        height: Math.min(520px, root.height - 60px);
        border-radius: 8px;
        background: AppTheme.surface-elevated;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text {
                text: "Forward To";
                color: AppTheme.text-strong;
                font-size: TypeScale.heading;
                font-weight: 700;
            }
            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                VerticalLayout {
                    alignment: start;
                    spacing: 1px;
                    for target in root.targets: PopupRow {
                        text: target.name;
                        clicked => { root.pick(target.id); }
                    }
                }
            }
        }
    }
}

export component MentionPopup inherits Rectangle {
    in property <[MentionItem]> items;
    in property <int> active;
    callback pick(int);
    height: Math.min(320px, root.items.length * 40px + 40px);
    border-radius: 8px;
    background: AppTheme.surface-elevated;
    border-width: 1px;
    border-color: AppTheme.border-subtle;
    drop-shadow-blur: 10px;
    drop-shadow-color: AppTheme.surface-scrim;
    TouchArea { }
    VerticalLayout {
        padding: 6px;
        spacing: 0px;
        Text {
            height: 26px;
            text: "MEMBERS";
            color: AppTheme.text-muted;
            font-size: TypeScale.micro;
            font-weight: 700;
            vertical-alignment: center;
        }
        for item[index] in root.items: Rectangle {
            height: 40px;
            border-radius: 4px;
            background: index == root.active || item_ta.has-hover ? AppTheme.interactive-selected : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: AppTheme.interactive-muted;
                        Text { text: item.avatar_text; color: AppTheme.text-strong; font-size: TypeScale.micro; font-weight: 700; }
                    }
                }
                Text {
                    text: item.name;
                    color: AppTheme.text-strong;
                    font-size: TypeScale.body;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: item.subtitle;
                    color: AppTheme.text-muted;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 170px;
                }
            }
            item_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(index); }
            }
        }
    }
}

export component ExpressionTabs inherits HorizontalLayout {
    in property <string> active;
    callback select(string);
    spacing: 4px;
    alignment: start;
    for tab in [{ id: "gif", name: "GIFs" }, { id: "sticker", name: "Stickers" }, { id: "emoji", name: "Emoji" }]: Rectangle {
        width: tab_text.preferred-width + 24px;
        height: 30px;
        border-radius: 6px;
        background: root.active == tab.id ? AppTheme.interactive-selected : (tab_ta.has-hover ? AppTheme.interactive-hover : transparent);
        animate background { duration: 100ms; easing: ease-out; }
        tab_text := Text {
            text: tab.name;
            color: root.active == tab.id ? AppTheme.text-strong : AppTheme.text-secondary;
            font-size: TypeScale.small;
            font-weight: 600;
        }
        tab_ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.select(tab.id); }
        }
    }
}

export component StreamPreviewCard inherits Rectangle {
    in property <string> name;
    in property <image> preview;
    in property <bool> has_preview;
    in property <bool> watching;
    out property <bool> hovered: card_ta.has-hover;
    callback watch();
    width: 280px;
    height: 216px;
    border-radius: 8px;
    background: AppTheme.surface-elevated;
    border-width: 1px;
    border-color: AppTheme.border-subtle;
    drop-shadow-blur: 12px;
    drop-shadow-color: AppTheme.surface-scrim;
    card_ta := TouchArea {
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                height: 18px;
                Text {
                    horizontal-stretch: 1;
                    text: "Streaming Now";
                    color: AppTheme.text-secondary;
                    font-size: TypeScale.caption;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 38px;
                    height: 16px;
                    border-radius: 8px;
                    background: AppTheme.danger-action;
                    Text { text: "LIVE"; color: AppTheme.text-on-accent; font-size: 11px; font-weight: 700; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 6px;
                background: AppTheme.surface-media;
                clip: true;
                if root.has_preview: Image {
                    width: 100%;
                    height: 100%;
                    source: root.preview;
                    image-fit: cover;
                }
                if !root.has_preview: Text {
                    text: "Stream just started. Get in here!";
                    color: AppTheme.text-primary;
                    font-size: TypeScale.small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: root.watching ? AppTheme.interactive-muted : (watch_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent);
                animate background { duration: 100ms; easing: ease-out; }
                Text {
                    text: root.watching ? "Watching Stream" : "Watch Stream";
                    color: root.watching ? AppTheme.text-muted : AppTheme.text-on-accent;
                    font-size: TypeScale.small;
                    font-weight: 600;
                }
                watch_ta := TouchArea {
                    enabled: !root.watching;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => { root.watch(); }
                }
            }
        }
    }
}
