import { LineEdit, ListView, ScrollView, Slider } from "std-widgets.slint";
import { AppTheme, TypeScale } from "../theme.slint";
import { Tr } from "tr.slint";

export struct MemberRow {
    is_group: bool,
    is_loaded: bool,
    label: string,
    user_id: string,
    avatar_text: string,
    avatar_url: string,
    avatar_slot: int,
    status_color: color,
    name_color: color,
    has_name_color: bool,
    is_bot: bool,
    activity: string,
    tag: string,
}

export struct ProfileBadge {
    name: string,
    img: image,
    loaded: bool,
}

export struct UserMenuItem {
    id: string,
    title: string,
    has_check: bool,
    checked: bool,
    has_color: bool,
    color: color,
}

export struct ProfileRole {
    name: string,
    color: color,
}

// Virtualized: only the rows on screen exist, whatever the size of the server.
export component MemberListPanel inherits Rectangle {
    in property <[MemberRow]> rows;
    in property <[image]> avatar_pool;
    in property <[string]> avatar_pool_urls;
    callback open_profile(string);
    callback open_user_menu(string, length, length);
    callback scrolled(int);

    background: AppTheme.surface-sidebar;

    list := ListView {
        width: 100%;
        height: 100%;
        changed viewport-y => {
            root.scrolled(Math.max(0, Math.floor(-self.viewport-y / 40px)));
        }

        for row in root.rows: Rectangle {
            height: 40px;
            background: !row.is_group && row.is_loaded && row_ta.has-hover ? AppTheme.interactive-hover : transparent;
            border-radius: 4px;

            if row.is_group: Text {
                x: 12px;
                width: parent.width - 20px;
                height: parent.height;
                text: row.label;
                color: AppTheme.text-muted;
                font-size: TypeScale.micro;
                font-weight: 800;
                vertical-alignment: bottom;
                overflow: elide;
            }

            if !row.is_group && !row.is_loaded: Rectangle {
                x: 10px;
                y: 6px;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: AppTheme.interactive-muted;
            }

            if !row.is_group && row.is_loaded: Rectangle {
                x: 10px;
                y: 6px;
                width: 28px;
                height: 28px;

                Rectangle {
                    border-radius: 14px;
                    background: AppTheme.interactive-selected;
                    clip: true;
                    Text {
                        text: row.avatar_text;
                        color: AppTheme.text-primary;
                        font-size: TypeScale.micro;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if row.avatar_url != "" && root.avatar_pool_urls[row.avatar_slot] == row.avatar_url: Image {
                        source: root.avatar_pool[row.avatar_slot];
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }

                Rectangle {
                    x: 19px;
                    y: 19px;
                    width: 11px;
                    height: 11px;
                    border-radius: 5.5px;
                    border-width: 2px;
                    border-color: AppTheme.surface-sidebar;
                    background: row.status_color;
                }
            }

            if !row.is_group && row.is_loaded: HorizontalLayout {
                x: 46px;
                y: row.activity != "" ? 3px : 0px;
                width: parent.width - 54px;
                height: row.activity != "" ? 19px : parent.height;
                spacing: 5px;
                alignment: start;

                Text {
                    text: row.label;
                    color: row.has_name_color ? row.name_color : AppTheme.text-secondary;
                    font-size: TypeScale.body;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if row.tag != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: tag_text.preferred-width + 8px;
                        height: 15px;
                        border-radius: 3px;
                        background: AppTheme.interactive-muted;
                        tag_text := Text {
                            text: row.tag;
                            color: AppTheme.text-secondary;
                            font-size: TypeScale.micro;
                            font-weight: 700;
                        }
                    }
                }

                if row.is_bot: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 15px;
                        border-radius: 3px;
                        background: AppTheme.accent;
                        Text {
                            text: "BOT";
                            color: AppTheme.text-on-accent;
                            font-size: TypeScale.micro;
                            font-weight: 700;
                        }
                    }
                }
            }

            if !row.is_group && row.is_loaded && row.activity != "": Text {
                x: 46px;
                y: 21px;
                width: parent.width - 54px;
                height: 15px;
                text: row.activity;
                color: AppTheme.text-muted;
                font-size: TypeScale.caption;
                vertical-alignment: center;
                overflow: elide;
            }

            row_ta := TouchArea {
                enabled: !row.is_group && row.is_loaded;
                mouse-cursor: self.enabled ? pointer : default;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                        root.open_user_menu(row.user_id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                clicked => { root.open_profile(row.user_id); }
            }
        }
    }
}

export component ProfileCard inherits Rectangle {
    in property <bool> loading;
    in property <string> display_name;
    in property <string> username;
    in property <string> pronouns;
    in property <string> bio;
    in property <string> member_since;
    in property <string> avatar_text;
    in property <image> avatar;
    in property <bool> has_avatar;
    in property <color> accent;
    in property <[ProfileRole]> roles;
    in property <string> mutual;
    in property <[ProfileBadge]> badges;
    in property <string> tag;
    in property <bool> has_status;
    in property <color> status_color;
    in property <string> status;
    in property <string> activity;
    in property <image> banner;
    in property <bool> has_banner;
    in property <bool> can_message: true;
    callback close();
    callback send_dm(string);

    background: AppTheme.backdrop-soft;

    TouchArea {
        clicked => { root.close(); }
    }

    card := Rectangle {
        width: 360px;
        height: Math.min(content.preferred-height, root.height - 40px);
        background: AppTheme.surface-elevated;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        clip: true;

        // Clicks on the card do not close it.
        TouchArea { }

        content := VerticalLayout {
            alignment: start;

            Rectangle {
                height: 105px;
                background: root.accent;
                clip: true;
                if root.has_banner: Image {
                    width: 100%;
                    height: 100%;
                    source: root.banner;
                    image-fit: cover;
                }
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: -46px;
                alignment: start;

                Rectangle {
                    width: 92px;
                    height: 92px;
                    border-radius: 46px;
                    border-width: 6px;
                    border-color: AppTheme.surface-elevated;
                    background: AppTheme.interactive-selected;
                    clip: true;

                    Text {
                        text: root.avatar_text;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.heading;
                        font-weight: 700;
                    }
                    if root.has_avatar: Image {
                        x: 6px;
                        y: 6px;
                        width: 80px;
                        height: 80px;
                        source: root.avatar;
                        image-fit: cover;
                    }
                }
            }

            VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                spacing: 12px;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.display_name;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.heading;
                        font-weight: 800;
                        overflow: elide;
                    }
                    Text {
                        text: root.pronouns != "" ? root.username + " · " + root.pronouns : root.username;
                        color: AppTheme.text-secondary;
                        font-size: TypeScale.small;
                        overflow: elide;
                    }
                }

                if root.badges.length > 0 || root.tag != "": HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    if root.tag != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: profile_tag.preferred-width + 10px;
                            height: 20px;
                            border-radius: 4px;
                            background: AppTheme.interactive-muted;
                            profile_tag := Text {
                                text: root.tag;
                                color: AppTheme.text-primary;
                                font-size: TypeScale.caption;
                                font-weight: 700;
                            }
                        }
                    }
                    for badge in root.badges: Rectangle {
                        width: 22px;
                        height: 22px;
                        accessible-role: image;
                        accessible-label: badge.name;
                        if badge.loaded: Image {
                            width: 20px;
                            height: 20px;
                            source: badge.img;
                            image-fit: contain;
                        }
                    }
                }

                if root.has_status: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.status_color;
                            }
                        }
                        Text {
                            text: root.status;
                            color: AppTheme.text-secondary;
                            font-size: TypeScale.small;
                            vertical-alignment: center;
                        }
                    }
                    if root.activity != "": Text {
                        text: root.activity;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.small;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                }

                if root.mutual != "": Text {
                    text: root.mutual;
                    color: AppTheme.text-muted;
                    font-size: TypeScale.caption;
                    overflow: elide;
                }

                if root.loading: Text {
                    text: "…";
                    color: AppTheme.text-muted;
                    font-size: TypeScale.title;
                }

                if root.bio != "": VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: Tr.profile_about;
                        color: AppTheme.text-muted;
                        font-size: TypeScale.micro;
                        font-weight: 800;
                    }
                    Text {
                        text: root.bio;
                        color: AppTheme.text-primary;
                        font-size: TypeScale.small;
                        wrap: word-wrap;
                    }
                }

                if root.member_since != "": VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: Tr.profile_member_since;
                        color: AppTheme.text-muted;
                        font-size: TypeScale.micro;
                        font-weight: 800;
                    }
                    Text {
                        text: root.member_since;
                        color: AppTheme.text-primary;
                        font-size: TypeScale.small;
                    }
                }

                if root.roles.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: Tr.profile_roles;
                        color: AppTheme.text-muted;
                        font-size: TypeScale.micro;
                        font-weight: 800;
                    }
                    for role in root.roles: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: role.color;
                            }
                        }
                        Text {
                            text: role.name;
                            color: AppTheme.text-primary;
                            font-size: TypeScale.small;
                            overflow: elide;
                        }
                    }
                }

                if root.can_message: Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppTheme.surface-input;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    if dm_input.text == "": Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: "Message @" + root.display_name;
                        color: AppTheme.text-subtle;
                        font-size: TypeScale.small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    dm_input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        color: AppTheme.text-primary;
                        font-size: TypeScale.small;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            if (self.text != "") {
                                root.send_dm(self.text);
                                self.text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    in property <bool> has-check: false;
    in property <bool> checked: false;
    callback clicked();

    height: 32px;
    border-radius: 4px;
    background: row_ta.has-hover ? (root.danger ? AppTheme.danger-action : AppTheme.interactive-selected) : transparent;

    Text {
        x: 10px;
        width: parent.width - 44px;
        height: parent.height;
        text: root.text;
        color: row_ta.has-hover && root.danger ? AppTheme.text-on-accent : (root.danger ? AppTheme.danger : AppTheme.text-primary);
        font-size: TypeScale.small;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.has-check: Rectangle {
        x: parent.width - 28px;
        y: 7px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.checked ? AppTheme.accent : AppTheme.text-muted;
        background: root.checked ? AppTheme.accent : transparent;
        if root.checked: Text {
            text: "✓";
            color: AppTheme.text-on-accent;
            font-size: TypeScale.caption;
            font-weight: 800;
        }
    }

    row_ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuLine inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: AppTheme.separator;
    }
}

export component UserContextMenu inherits Rectangle {
    in property <length> menu-x;
    in property <length> menu-y;
    in property <string> name;
    in property <bool> is_self;
    in property <bool> in_voice;
    in-out property <float> volume;
    in-out property <bool> muted;
    in property <bool> server_muted;
    in property <bool> server_deafened;
    in property <bool> can_mute;
    in property <bool> can_deafen;
    in property <bool> can_move;
    in property <bool> can_kick;
    in property <bool> can_ban;
    in property <bool> can_roles;
    in property <bool> blocked;
    in property <string> sub;
    in property <[UserMenuItem]> sub_items;
    in-out property <string> note;
    in-out property <string> confirm;
    in property <string> error;
    callback close();
    callback action(string);
    callback volume_changed(float);
    in property <bool> has_stream;
    in-out property <float> stream_volume: 1.0;
    property <float> stream_volume_before_mute: 1.0;
    callback stream_volume_changed(float);
    callback toggle_mute();

    property <bool> has_moderation: (root.in_voice && (root.can_mute || root.can_deafen || root.can_move)) || root.can_kick || root.can_ban || root.can_roles;

    TouchArea {
        clicked => { root.close(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.close();
            }
        }
    }

    menu := Rectangle {
        width: 230px;
        height: Math.min(items.preferred-height, root.height - 16px);
        x: Math.max(8px, Math.min(root.menu-x, root.width - self.width - 8px));
        y: Math.max(8px, Math.min(root.menu-y, root.height - self.height - 8px));
        background: AppTheme.surface-elevated;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        drop-shadow-blur: 12px;
        drop-shadow-color: AppTheme.surface-scrim;
        clip: true;

        TouchArea { }

        items := VerticalLayout {
            padding: 6px;
            spacing: 1px;
            alignment: start;

            if root.confirm != "": VerticalLayout {
                spacing: 8px;
                padding: 6px;
                Text {
                    text: (root.confirm == "kick" ? "Kick " : (root.confirm == "ban" ? "Ban " : (root.confirm == "block" ? "Block " : "Disconnect "))) + root.name + "?";
                    color: AppTheme.text-strong;
                    font-size: TypeScale.body;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                MenuRow {
                    text: root.confirm == "kick" ? "Yes, kick" : (root.confirm == "ban" ? "Yes, ban" : (root.confirm == "block" ? "Yes, block" : "Yes, disconnect"));
                    danger: true;
                    clicked => { root.action(root.confirm); }
                }
                MenuRow {
                    text: "Cancel";
                    clicked => { root.confirm = ""; }
                }
            }

            if root.confirm == "" && root.sub != "": VerticalLayout {
                spacing: 4px;
                MenuRow { text: "‹ Back"; clicked => { root.action("back"); } }
                MenuLine { }
                if root.sub == "note": VerticalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.note;
                        placeholder-text: "Click to add a note";
                    }
                    MenuRow { text: "Save Note"; clicked => { root.action("save_note"); } }
                }
                if root.sub != "note": ScrollView {
                    height: Math.min(sub_rows.preferred-height, 300px);
                    viewport-width: self.visible-width;
                    sub_rows := VerticalLayout {
                        alignment: start;
                        spacing: 1px;
                        for entry in root.sub_items: Rectangle {
                            height: 32px;
                            if entry.has_color: Rectangle {
                                x: 2px;
                                y: 11px;
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: entry.color;
                            }
                            MenuRow {
                                x: entry.has_color ? 12px : 0px;
                                width: parent.width - (entry.has_color ? 12px : 0px);
                                text: entry.title;
                                has-check: entry.has_check;
                                checked: entry.checked;
                                clicked => { root.action("pick:" + entry.id); }
                            }
                        }
                    }
                }
                if root.error != "": Text {
                    text: root.error;
                    color: AppTheme.danger;
                    font-size: TypeScale.caption;
                    wrap: word-wrap;
                }
            }

            if root.confirm == "" && root.sub == "": VerticalLayout {
                spacing: 1px;

                MenuRow { text: "Profile"; clicked => { root.action("profile"); } }
                MenuRow { text: "Mention"; clicked => { root.action("mention"); } }
                if !root.is_self: MenuRow { text: "Message"; clicked => { root.action("message"); } }
                if !root.is_self: MenuRow { text: "Add Note"; clicked => { root.action("open_note"); } }

                if !root.is_self: MenuLine { }
                if !root.is_self: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 2px;
                    Text {
                        text: "User Volume  " + Math.round(root.volume * 100) + "%";
                        color: AppTheme.text-primary;
                        font-size: TypeScale.small;
                        font-weight: 500;
                    }
                    Slider {
                        minimum: 0.0;
                        maximum: 2.0;
                        value: root.volume;
                        changed(val) => {
                            root.volume = val;
                            root.volume_changed(val);
                        }
                    }
                }
                if !root.is_self: MenuRow {
                    text: "Mute";
                    has-check: true;
                    checked: root.muted;
                    clicked => {
                        root.muted = !root.muted;
                        root.toggle_mute();
                    }
                }

                if !root.is_self && root.has_stream: MenuLine { }
                if !root.is_self && root.has_stream: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 2px;
                    Text {
                        text: "Stream Volume  " + Math.round(root.stream_volume * 100) + "%";
                        color: AppTheme.text-primary;
                        font-size: TypeScale.small;
                        font-weight: 500;
                    }
                    Slider {
                        minimum: 0.0;
                        maximum: 1.0;
                        value: root.stream_volume;
                        changed(val) => {
                            root.stream_volume = val;
                            root.stream_volume_changed(val);
                        }
                    }
                }
                if !root.is_self && root.has_stream: MenuRow {
                    text: "Mute Stream";
                    has-check: true;
                    checked: root.stream_volume <= 0.001;
                    clicked => {
                        if (root.stream_volume > 0.001) {
                            root.stream_volume_before_mute = root.stream_volume;
                            root.stream_volume = 0;
                        } else {
                            root.stream_volume = root.stream_volume_before_mute;
                        }
                        root.stream_volume_changed(root.stream_volume);
                    }
                }

                if root.has_moderation: MenuLine { }
                if root.in_voice && root.can_mute: MenuRow {
                    text: "Server Mute";
                    danger: true;
                    has-check: true;
                    checked: root.server_muted;
                    clicked => { root.action("server_mute"); }
                }
                if root.in_voice && root.can_deafen: MenuRow {
                    text: "Server Deafen";
                    danger: true;
                    has-check: true;
                    checked: root.server_deafened;
                    clicked => { root.action("server_deafen"); }
                }
                if root.can_roles: MenuRow { text: "Roles  ›"; clicked => { root.action("open_roles"); } }
                if root.in_voice && root.can_move: MenuRow { text: "Move To  ›"; clicked => { root.action("open_move"); } }
                if root.in_voice && root.can_move: MenuRow {
                    text: "Disconnect";
                    danger: true;
                    clicked => { root.confirm = "disconnect"; }
                }
                if root.can_kick: MenuRow {
                    text: "Kick " + root.name;
                    danger: true;
                    clicked => { root.confirm = "kick"; }
                }
                if root.can_ban: MenuRow {
                    text: "Ban " + root.name;
                    danger: true;
                    clicked => { root.confirm = "ban"; }
                }

                MenuLine { }
                if !root.is_self && !root.blocked: MenuRow { text: "Block"; danger: true; clicked => { root.confirm = "block"; } }
                if !root.is_self && root.blocked: MenuRow { text: "Unblock"; clicked => { root.action("unblock"); } }
                MenuRow { text: "Copy User ID"; clicked => { root.action("copy_id"); } }

                if root.error != "": Text {
                    text: root.error;
                    color: AppTheme.danger;
                    font-size: TypeScale.caption;
                    wrap: word-wrap;
                }
            }
        }
    }
}
