import { AppTheme, TypeScale } from "../theme.slint";

component PlayerButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> tint: AppTheme.text-secondary;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: root.label;
    background: ta.has-hover ? AppTheme.interactive-hover : transparent;
    Image {
        width: 22px;
        height: 22px;
        source: root.icon;
        colorize: ta.has-hover ? AppTheme.text-strong : root.tint;
        image-fit: contain;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The whole 32px strip reacts, so the thin bar is easy to hit.
component PlayerSlider inherits Rectangle {
    in property <float> value;
    callback changed-value(float);
    height: 32px;
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: AppTheme.interactive-selected;
        Rectangle {
            x: 0px;
            width: parent.width * root.value.clamp(0, 1);
            border-radius: 3px;
            background: AppTheme.accent;
        }
    }
    Rectangle {
        x: parent.width * root.value.clamp(0, 1) - 7px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: AppTheme.solid-white;
        visible: slider_ta.has-hover || slider_ta.pressed;
    }
    slider_ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.changed-value((self.mouse-x / self.width).clamp(0, 1));
            }
        }
        moved => {
            if (self.pressed) {
                root.changed-value((self.mouse-x / self.width).clamp(0, 1));
            }
        }
    }
}

// The picture is a native child window placed over `area`, so controls stay outside it.
export component VideoPlayer inherits Rectangle {
    in property <string> title;
    in property <string> time;
    in property <string> status;
    in property <bool> playing;
    in property <bool> fullscreen;
    in property <float> position;
    in property <float> volume: 1;
    callback action(string, float);
    callback area_changed(length, length, length, length);

    background: root.fullscreen ? #000000 : AppTheme.backdrop-max;
    forward-focus: keys;
    init => { keys.focus(); }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.action(root.fullscreen ? "fullscreen" : "close", 0);
                return accept;
            }
            if (event.text == " ") {
                root.action("toggle", 0);
                return accept;
            }
            return reject;
        }
    }
    TouchArea { }

    property <length> margin: root.fullscreen ? 0px : 32px;
    property <length> top: root.fullscreen ? 0px : 52px;

    area := Rectangle {
        property <length> at-x: self.absolute-position.x;
        property <length> at-y: self.absolute-position.y;
        x: root.margin;
        y: root.top;
        width: root.width - root.margin * 2;
        height: root.height - root.top - 60px;
        background: #000000;
        init => { root.area_changed(self.at-x, self.at-y, self.width, self.height); }
        changed at-x => { root.area_changed(self.at-x, self.at-y, self.width, self.height); }
        changed at-y => { root.area_changed(self.at-x, self.at-y, self.width, self.height); }
        changed width => { root.area_changed(self.at-x, self.at-y, self.width, self.height); }
        changed height => { root.area_changed(self.at-x, self.at-y, self.width, self.height); }
    }

    if !root.fullscreen: HorizontalLayout {
        x: 32px;
        y: 6px;
        width: root.width - 64px;
        height: 40px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: AppTheme.text-strong;
            font-size: TypeScale.body;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        PlayerButton { icon: @image-url("../../assets/external-link.svg"); label: "Open in Browser"; clicked => { root.action("browser", 0); } }
        PlayerButton { icon: @image-url("../../assets/x.svg"); label: "Close"; clicked => { root.action("close", 0); } }
    }

    if root.status != "": Text {
        x: root.margin;
        y: root.height - 84px;
        width: root.width - root.margin * 2;
        text: root.status;
        color: AppTheme.warning;
        font-size: TypeScale.small;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        x: root.margin + 4px;
        y: root.height - 52px;
        width: root.width - root.margin * 2 - 8px;
        height: 44px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            PlayerButton {
                icon: root.playing ? @image-url("../../assets/pause.svg") : @image-url("../../assets/play.svg");
                label: root.playing ? "Pause" : "Play";
                tint: AppTheme.text-strong;
                clicked => { root.action("toggle", 0); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            PlayerSlider {
                value: root.position;
                changed-value(v) => { root.action("seek", v); }
            }
        }
        Text {
            text: root.time;
            color: AppTheme.text-secondary;
            font-size: TypeScale.small;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            PlayerButton {
                icon: root.volume <= 0.01 ? @image-url("../../assets/volume-x.svg") : @image-url("../../assets/speaker.svg");
                label: root.volume <= 0.01 ? "Unmute" : "Mute";
                tint: root.volume <= 0.01 ? AppTheme.danger : AppTheme.text-secondary;
                clicked => { root.action("mute", 0); }
            }
        }
        VerticalLayout {
            alignment: center;
            width: 110px;
            PlayerSlider {
                value: root.volume;
                changed-value(v) => { root.action("volume", v); }
            }
        }
        VerticalLayout {
            alignment: center;
            PlayerButton {
                icon: root.fullscreen ? @image-url("../../assets/fullscreen-exit.svg") : @image-url("../../assets/fullscreen.svg");
                label: root.fullscreen ? "Exit Full Screen" : "Full Screen";
                clicked => { root.action("fullscreen", 0); }
            }
        }
    }
}
